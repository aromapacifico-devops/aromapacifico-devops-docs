 id="0915" value="HTTPS 443, visitors 80 and 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="net"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0917" value="IPsec VPN, logistics and local servers only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="vgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="405"/><mxPoint x="1125" y="566"/></Array></mxGeometry></mxCell><mxCell id="0918" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="vgw" target="eps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0925" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="768" as="sourcePoint"/><mxPoint x="98" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0927" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="790" as="sourcePoint"/><mxPoint x="98" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0929" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge=