t;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF6EC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="146" width="470" height="24" as="geometry"/></mxCell><mxCell id="1530" value="Phone side, when the phone has data" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF2F8;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="488" width="470" height="24" as="geometry"/></mxCell><mxCell id="1531" value="Five minutes after the publish" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#FEF9E7;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="696" width="470" height="24" as="geometry"/></mxCell><mxCell id="1541" value="&lt;b&gt;On the phone.&lt;/b&gt; The application shows the notification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="980" y="552" width="200" height="44" as="geometry"/></mxCell><mxCell id="1545" value="&lt;b&gt;No handoff.&lt;/b&gt; Undelivered metric and alarm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1520" y="756" width="300" height="34" as="geometry"/></mxCell><mxCell id="1547" value="&lt;b&gt;SMS events.&lt;/b&gt; End User Messaging writes them to the status logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="830" width="300" height="34" as="geometry"/></mxCell><mxCell id="1549" value="&lt;b&gt;No data on the phone.&lt;/b&gt; The push waits up to 24 hours at the push service, and the receipt goes with the next call. The objective stops at the handoff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="916" width="560" height="44" as="geometry"/></mxCell><mxCell id="1550" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="916" width="560" height="140" as="geometry"/></mxCell><mxCell id="1552" value="Alert on its way to the phone" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="726" y="944" width="486" height="20" as="geometry"/></mxCell><mxCell id="1554" value="Write to the delivery record" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="726" y="966" width="486" height="20" as="geometry"/></mxCell><mxCell id="1556" value="Control and confirmation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="726" y="988" width="486" height="20" as="geometry"/></mxCell><mxCell id="1558" value="SMS fallback for urgent alerts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="726" y="1010" width="486" height="20" as="geometry"/></mxCell><mxCell id="1560" value="Dashed line, an answer to a request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="726" y="1032" width="486" height="20" as="geometry"/></mxCell><mxCell id="1532" value="Alert, live or drained" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="196" as="sourcePoint"/><mxPoint x="390" y="196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1533" value="Publish data message, TTL 24 h" style="endArrow=block;endFill=1;html=1;strokeColor=#E65100;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="230" as="sourcePoint"/><mxPoint x="620" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1534" value="Message ID" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="264" as="sourcePoint"/><mxPoint x="160" y="264" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1535" value="Push ID, publish time" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="298" as="sourcePoint"/><mxPoint x="390" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1536" value="Check message, delay 300 s" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="332" as="sourcePoint"/><mxPoint x="1770" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1537" value="Handoff after the dwell time" style="endArrow=block;endFill=1;html=1;strokeColor=#E65100;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="366" as="sourcePoint"/><mxPoint x="850" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1538" value="Delivery status, dwellTimeMs" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="400" as="sourcePoint"/><mxPoint x="1540" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1539" value="push_handoff_at, push_status" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="434" as="sourcePoint"/><mxPoint x="390" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1540" value="Data message, high priority" style="endArrow=block;endFill=1;html=1;strokeColor=#E65100;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="530" as="sourcePoint"/><mxPoint x="1080" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1542" value="POST receipt, time on the phone" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="616" as="sourcePoint"/><mxPoint x="1310" y="616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1543" value="receipt_at, device_received_at" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=