</mxGeometry></mxCell><mxCell id="1639" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="844" as="sourcePoint"/><mxPoint x="98" y="844" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="17 Public query"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="860" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="171" value="How a buyer reads one sack by code, and what limits bulk reads of the public query" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1920" height="34" as="geometry"/></mxCell><mxCell id="172" value="Public internet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="600" as="geometry"/></mxCell><mxCell id="buyer" value="&lt;b&gt;Buyer phone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Scans the QR, no sign-in&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="220" height="64" as="geometry"/></mxCell><mxCell id="173" value="" style="sketch=0;html=1;shape=mxgraph.networks.mobile;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="166" width="32" height="32" as="geometry"/></mxCell><mxCell id="direct" value="&lt;b&gt;Direct caller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Calls the function URL address&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=1.2;dashed=1;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="220" height="64" as="geometry"/></mxCell><mxCell id="174" value="" style="sketch=0;html=1;shape=mxgraph.networks.pc;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="576" width="32" height="32" as="geometry"/></mxCell><mxCell id="175" value="CloudFront edge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="490" height="600" as="geometry"/></mxCell><mxCell id="waf" value="&lt;b&gt;AWS WAF web ACL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;300 per address in 5 min, managed rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="180" height="84" as="geometry"/></mxCell><mxCell id="176" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="447" y="166" width="32" height="32" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;Distribution&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Page cached, lookup path not cached&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="670" y="140" width="160" height="84" as="geometry"/></mxCell><mxCell id="177" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="677" y="166" width="32" height="32" as="geometry"/></mxCell><mxCell id="178" value="AWS us-east-1, production account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="80" width="830" height="600" as="geometry"/></mxCell><mxCell id="page" value="&lt;b&gt;Query page bucket&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;S3, read by the distribution only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="210" height="84" as="geometry"/></mxCell><mxCell id="179" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="957" y="166" width="32" height="32" as="geometry"/></mxCell><mxCell id="fn" value="&lt;b&gt;Lookup function&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Function URL, IAM auth, 5 reserved copies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="320" width="210" height="84" as="geometry"/></mxCell><mxCell id="1710" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="957" y="346" width="32" height="32" as="geometry"/></mxCell><mxCell id="table" value="&lt;b&gt;Buyer view table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;buyer_views, GetItem only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="200" height="64" as="geometry"/></mxCell><mxCell id="1711" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1247" y="346" width="32" height="32" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit log group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;One event per lookup&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="200" height="64" as="geometry"/></mxCell><mxCell id="1712" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1507" y="346" width="32" height="32" as="geometry"/></mxCell><mxCell id="alarm" value="&lt;b&gt;CloudWatch alarms&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Over 1,500 in 5 min, any throttle&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="500" width="210" height="64" as="geometry"/></mxCell><mxCell id="1713" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1247" y="516" width="32" height="32" as="geometry"/></mxCell><mxCell id="1714" value="Operations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#616161;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1760" y="80" width="200" height="600" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Platform operator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Blocks addresses or sets 0 copies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1775" y="500" width="170" height="64" as="geometry"/></mxCell><mxCell id="1715" value="" style="sketch=0;html=1;shape=mxgraph.networks.pc;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1782" y="516" width="32" height="32" as="geometry"/></mxCell><mxCell id="1725" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="420" height="118" as="geometry"/></mxCell><mxCell id="1727" value="Lookup of one sack" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="738" width="346" height="20" as="geometry"/></mxCell><mxCell id="1729" value="Query page, cached at the edge" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="760" width="346" height="20" as="geometry"/></mxCell><mxCell id="1731" value="Request that never reaches the function" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="782" width="346" height="20" as="geometry"/></mxCell><mxCell id="1733" value="Alarm and response" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="804" width="346" height="20" as="geometry"/></mxCell><mxCell id="1734" value="&lt;b&gt;Peak.&lt;/b&gt; 30 lookups a minute, 0.5 a second, 0.1 copies running on average. With 5 reserved copies a buyer meets a refusal about once in ten million lookups. The ceiling is 25 a second, about 50 times the peak" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="710" width="470" height="64" as="geometry"/></mxCell><mxCell id="1735" value="&lt;b&gt;Bulk reads.&lt;/b&gt; Codes of 60 random bits. A month of guesses at the ceiling finds about 0.0002 valid codes, and each hit shows one buyer view with no personal data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1000" y="710" width="460" height="64" as="geometry"/></mxCell><mxCell id="1736" value="&lt;b&gt;Response.&lt;/b&gt; First a temporary rule blocks the addresses. If they are too many, reserved copies go to 0 and every lookup gets 429. Then back to 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1490" y="710" width="470" height="64" as="geometry"/></mxCell><mxCell id="1716" value="HTTPS, page and lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="buyer" target="waf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="182"/></Array></mxGeometry></mxCell><mxCell id="1717" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="waf" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1718" value="page, signed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="cf" target="page"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1719" value="lookup, signed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="fn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="362"/></Array></mxGeometry></mxCell><mxCell id="1720" value="GetItem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="table"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1721" value="audit event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="290"/><mxPoint x="1600" y="290"/></Array></mxGeometry></mxCell><mxCell id="1722" value="invocations, throttles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="alarm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="532"/></Array></mxGeometry></mxCell><mxCell id="1723" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="alarm" target="op"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1724" value="unsigned, refused with 403" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="direct" target="fn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="992" y="592"/></Array></mxGeometry></mxCell><mxCell id="1726" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="748" as="sourcePoint"/><mxPoint x="98" y="748" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1728" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="770" as="sourcePoint"/><mxPoint x="98" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1730" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="792" as="sourcePoint"/><mxPoint x="98" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1732" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="814" as="sourcePoint"/><mxPoint x="98" y="814" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="18 Center cloud link"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="181" value="How a collection center reaches the cloud: tunnels, routes, names and what happens when the link fails" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1620" height="34" as="geometry"/></mxCell><mxCell id="182" value="Collection center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="560" height="560" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;Logistics&lt;/b&gt;&lt;br&gt;10.X.3.0/24&lt;br&gt;stations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="250" height="70" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b&gt;Local servers&lt;/b&gt;&lt;br&gt;10.X.10.0/24&lt;br&gt;label printer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="230" height="70" as="geometry"/></mxCell><mxCell id="fw" value="&lt;b&gt;Firewall of the center&lt;/b&gt;&lt;br&gt;IKEv2, static public address, two tunnels&lt;br&gt;routes only to the endpoint subnets of each environment&lt;br&gt;no forwarding between tunnels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="500" height="100" as="geometry"/></mxCell><mxCell id="wan" value="&lt;b&gt;One WAN link&lt;/b&gt;&lt;br&gt;100 Mbps, shared by both tunnels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="500" height="60" as="geometry"/></mxCell><mxCell id="186" value="Management, Support, Transport, Visitors and the firewall range have no route to the cloud." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="500" height="50" as="geometry"/></mxCell><mxCell id="187" value="&lt;b&gt;DNS.&lt;/b&gt; The firewall answers every zone and forwards to two public resolvers. It also holds a local record for the IoT Core data name, with the addresses of the endpoint interfaces." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="500" height="80" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;Tunnel 1&lt;/b&gt;&lt;br&gt;IPsec, started by AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Tunnel 2&lt;/b&gt;&lt;br&gt;IPsec, started by AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="350" width="200" height="60" as="geometry"/></mxCell><mxCell id="1810" value="Both tunnels end on the same firewall and the same WAN. They cover a failure of an AWS tunnel endpoint, and a failure of the WAN or the firewall takes both." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="630" y="440" width="260" height="100" as="geometry"/></mxCell><mxCell id="1811" value="Cloud, one environment, production shown" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="750" height="560" as="geometry"/></mxCell><mxCell id="vgw" value="&lt;b&gt;Virtual private gateway&lt;/b&gt;&lt;br&gt;one for each environment&lt;br&gt;one connection for each center&lt;br&gt;static routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="290" width="230" height="100" as="geometry"/></mxCell><mxCell id="rtc" value="&lt;b&gt;rt-private-center&lt;/b&gt;&lt;br&gt;explicit routes to 10.41.3.0/24, 10.41.10.0/24, 10.42.3.0/24, 10.42.10.0/24, 10.43.3.0/24, 10.43.10.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="410" height="80" as="geometry"/></mxCell><mxCell id="iot" value="&lt;b&gt;IoT Core data endpoint&lt;/b&gt;&lt;br&gt;10.70.0.0/24 and 10.70.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="220" width="410" height="60" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;S3 interface endpoint&lt;/b&gt;&lt;br&gt;10.70.16.0/24 and 10.70.17.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="300" width="410" height="60" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Private REST API endpoint&lt;/b&gt;&lt;br&gt;10.70.32.0/24 and 10.70.33.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="410" height="60" as="geometry"/></mxCell><mxCell id="1818" value="&lt;b&gt;rt-private&lt;/b&gt; serves data, object storage, administration and public query, and holds no route to a center. Security groups and network ACLs still decide what may pass on the routes above." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="470" width="410" height="100" as="geometry"/></mxCell><mxCell id="1819" value="Names from a center, each one read in documentation and not tested" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1640" height="190" as="geometry"/></mxCell><mxCell id="1820" value="&lt;b&gt;Private REST API.&lt;/b&gt; Endpoint-specific name vpce.execute-api, header x-apigw-api-id. Public DNS returns the private addresses. TLS 1.2 or later, security policy TLS_1_2 or access mode BASIC." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="520" height="120" as="geometry"/></mxCell><mxCell id="1821" value="&lt;b&gt;S3.&lt;/b&gt; Endpoint-specific name bucket.vpce, resolvable from the public S3 domain. TLS 1.2 only. Presigned URLs against that name are not verified. The gateway endpoint cannot be reached from a center." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="520" height="120" as="geometry"/></mxCell><mxCell id="1822" value="&lt;b&gt;IoT Core data.&lt;/b&gt; No private DNS and no regional or zonal public name, so the firewall holds a local record. Server name required, ATS certificates, port 443 with ALPN or 8883 to be shown. A Resolver costs USD 182.50 a month and is not adopted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1130" y="700" width="520" height="120" as="geometry"/></mxCell><mxCell id="1823" value="When the link fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="1100" height="180" as="geometry"/></mxCell><mxCell id="1824" value="&lt;b&gt;One tunnel down.&lt;/b&gt; Traffic moves to the other. The firewall must stop using the failed one. No recovery time is promised." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="920" width="340" height="110" as="geometry"/></mxCell><mxCell id="1825" value="&lt;b&gt;Both down, WAN or firewall down.&lt;/b&gt; Reception goes on, events queue on the devices, calls to the cloud time out. Alarm on TunnelState below 1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="410" y="920" width="340" height="110" as="geometry"/></mxCell><mxCell id="1826" value="&lt;b&gt;Tunnels up, traffic dropped.&lt;/b&gt; TunnelState stays at 1. Flow logs and application errors show it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="920" width="340" height="110" as="geometry"/></mxCell><mxCell id="1827" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="870" width="510" height="96" as="geometry"/></mxCell><mxCell id="1829" value="Tunnel" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1226" y="898" width="436" height="20" as="geometry"/></mxCell><mxCell id="1831" value="Route in the cloud" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1226" y="920" width="436" height="20" as="geometry"/></mxCell><mxCell id="1833" value="Inside the center" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1226" y="942" width="436" height="20" as="geometry"/></mxCell><mxCell id="1834" value="&lt;b&gt;Static routing.&lt;/b&gt; BGP is a future alternative with conditions, not a backup of the static routes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="990" width="510" height="50" as="geometry"/></mxCell><mxCell id="183" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="log" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="184" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="185" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="wan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="188" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="189" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1812" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="vgw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1813" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="vgw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1814" value="routes and return" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vgw" target="rtc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1065" y="150"/></Array></mxGeometry></mxCell><mxCell id="1815" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vgw" target="iot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1816" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vgw" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1817" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vgw" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1828" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="908" as="sourcePoint"/><mxPoint x="1218" y="908" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1830" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="930" as="sourcePoint"/><mxPoint x="1218" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1832" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="952" as="sourcePoint"/><mxPoint x="1218" y="952" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="19 Inference functions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="191" value="How a complete mission record or archive object reaches one of four inference results" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2120" height="34" as="geometry"/></mxCell><mxCell id="192" value="&lt;b&gt;Published inputs only.&lt;/b&gt; A drone function starts after the flight record is published with every mandatory object verified. A telemetry function starts on one completed Parquet object. Each function reads exact S3 versions, writes an idempotent result and never changes case state when it fails." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#AEB6BF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2120" height="40" as="geometry"/></mxCell><mxCell id="193" value="A. Complete persisted inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="530" height="840" as="geometry"/></mxCell><mxCell id="194" value="Drone mission link" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="500" height="320" as="geometry"/></mxCell><mxCell id="gs" value="&lt;b&gt;Ground station&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Uploads every object and its closed log&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="175" width="200" height="64" as="geometry"/></mxCell><mxCell id="195" value="" style="sketch=0;html=1;shape=mxgraph.networks.pc;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="191" width="32" height="32" as="geometry"/></mxCell><mxCell id="objs" value="&lt;b&gt;Flight objects in S3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Encrypted, versioned, SHA-256&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="285" y="175" width="200" height="64" as="geometry"/></mxCell><mxCell id="196" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="292" y="191" width="32" height="32" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;Completion check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manifest, signature, every mandatory object&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="260" width="420" height="66" as="geometry"/></mxCell><mxCell id="197" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="72" y="277" width="32" height="32" as="geometry"/></mxCell><mxCell id="frecord" value="&lt;b&gt;flight.record.published&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Published after every hash and version matches&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="350" width="420" height="66" as="geometry"/></mxCell><mxCell id="198" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="72" y="367" width="32" height="32" as="geometry"/></mxCell><mxCell id="1912" value="Telemetry archive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E7D32;strokeWidth=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="45" y="490" width="500" height="430" as="geometry"/></mxCell><mxCell id="fh" value="&lt;b&gt;Firehose&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Parquet, 900-second buffer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="525" width="200" height="64" as="geometry"/></mxCell><mxCell id="1913" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;" vertex="1" parent="1"><mxGeometry x="72" y="541" width="32" height="32" as="geometry"/></mxCell><mxCell id="arc" value="&lt;b&gt;Telemetry archive&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;crop/ and drying/, five years&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="285" y="525" width="200" height="64" as="geometry"/></mxCell><mxCell id="1914" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="292" y="541" width="32" height="32" as="geometry"/></mxCell><mxCell id="tobj" value="&lt;b&gt;S3 Object Created&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;One finished Parquet object&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="610" width="420" height="66" as="geometry"/></mxCell><mxCell id="1915" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="72" y="627" width="32" height="32" as="geometry"/></mxCell><mxCell id="1916" value="The event fires for each completed object. No mission manifest is involved, and no alert state changes in this path." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65" y="700" width="420" height="86" as="geometry"/></mxCell><mxCell id="1919" value="B. One work queue and failure queue per function" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="560" height="840" as="geometry"/></mxCell><mxCell id="eb" value="&lt;b&gt;EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Rule matched by event type&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="250" height="70" as="geometry"/></mxCell><mxCell id="1920" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#fff