Point x="948" y="977" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="14 Crop case states"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="141" value="Crop case states: from a cultivation alert to a focus confirmed or discarded by a person" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1720" height="34" as="geometry"/></mxCell><mxCell id="142" value="Case opens and the focus is built" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="520" height="500" as="geometry"/></mxCell><mxCell id="143" value="Drone flight, with no connection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="520" height="500" as="geometry"/></mxCell><mxCell id="144" value="Decision of a person" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="640" height="500" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;open&lt;/b&gt;&lt;br&gt;alert or reported&lt;br&gt;symptom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="focus" value="&lt;b&gt;focus_ready&lt;/b&gt;&lt;br&gt;50 m around the node,&lt;br&gt;cut to the lot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b&gt;location_pending&lt;/b&gt;&lt;br&gt;no position, lot&lt;br&gt;or flyable area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="170" height="76" as="geometry"/></mxCell><mxCell id="geo" value="&lt;b&gt;geometry_blocked&lt;/b&gt;&lt;br&gt;polygon missing&lt;br&gt;or suspended" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="170" height="76" as="geometry"/></mxCell><mxCell id="mreq" value="&lt;b&gt;mission_requested&lt;/b&gt;&lt;br&gt;exact polygon and&lt;br&gt;zone versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="fpub" value="&lt;b&gt;flight_published&lt;/b&gt;&lt;br&gt;log and evidence&lt;br&gt;verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="870" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="stale" value="&lt;b&gt;mission_stale&lt;/b&gt;&lt;br&gt;package can no longer&lt;br&gt;fly, rebuilt as a new attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="170" height="76" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;pending_review&lt;/b&gt;&lt;br&gt;evidence and&lt;br&gt;inference ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1140" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="retry" value="&lt;b&gt;retry&lt;/b&gt;&lt;br&gt;inconclusive,&lt;br&gt;evidence kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1140" y="420" width="170" height="76" as="geometry"/></mxCell><mxCell id="conf" value="&lt;b&gt;confirmed&lt;/b&gt;&lt;br&gt;a fumigation order&lt;br&gt;may follow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1440" y="190" width="170" height="76" as="geometry"/></mxCell><mxCell id="disc" value="&lt;b&gt;discarded&lt;/b&gt;&lt;br&gt;a later alert&lt;br&gt;opens a new case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#616161;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1440" y="330" width="170" height="76" as="geometry"/></mxCell><mxCell id="1419" value="polygon, focus or window changed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="690" y="350" width="200" height="40" as="geometry"/></mxCell><mxCell id="1420" value="reviewer finds it inconclusive" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1230" y="350" width="150" height="40" as="geometry"/></mxCell><mxCell id="1421" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="520" height="118" as="geometry"/></mxCell><mxCell id="1423" value="Normal path, conditional write" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="628" width="446" height="20" as="geometry"/></mxCell><mxCell id="1425" value="Blocked or failed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="650" width="446" height="20" as="geometry"/></mxCell><mxCell id="1427" value="Recovery by a person or an event" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="672" width="446" height="20" as="geometry"/></mxCell><mxCell id="1429" value="Discarded by the reviewer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="694" width="446" height="20" as="geometry"/></mxCell><mxCell id="1430" value="&lt;b&gt;Drying alerts&lt;/b&gt; only notify the farmer. Guidance ranges and references open no case. One node keeps one open case, and new alerts attach to it." style="rounded=0;whiteSpace=wrap;html=1;fillCol