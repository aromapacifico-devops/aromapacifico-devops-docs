<mxfile host="app.diagrams.net"><diagram name="00 Platform overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1690" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="001" value="Aroma Pacifico: target platform on AWS, from the farm to the port of Buenaventura" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2560" height="34" as="geometry"/></mxCell><mxCell id="002" value="Pilot of 200 farms, 3 collection centers and 60 carriers in Cauca, Huila and Tolima. AWS us-east-1 is primary and Azure East US stays prepared. The same pattern grows to 1,000 farms." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5D6D7E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="2000" height="22" as="geometry"/></mxCell><mxCell id="003" value="A. External parties" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#AEB6BF;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="76" width="2580" height="128" as="geometry"/></mxCell><mxCell id="ext0" value="&lt;b&gt;Federation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sets alert ranges, reads reports, approves changes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext1" value="&lt;b&gt;Platform operators&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Console with SSO and MFA&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="368" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext2" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Code, pull requests and Actions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="686" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext3" value="&lt;b&gt;Mobile operators&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;LTE in municipal seats and main roads&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1004" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext4" value="&lt;b&gt;Apple and Google push&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Deliver alerts to phones&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1322" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext5" value="&lt;b&gt;Shipping company&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Keeps its own telemetry, no integration&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1640" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext6" value="&lt;b&gt;Coffee buyers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Read one sack by code&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1958" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="ext7" value="&lt;b&gt;Data regulator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Colombian rules on personal data&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2276" y="112" width="300" height="74" as="geometry"/></mxCell><mxCell id="004" value="B. Field and sites" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#6AA84F;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="520" height="1200" as="geometry"/></mxCell><mxCell id="005" value="Farm with signal, repeated for each covered farm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6AA84F;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="46" y="252" width="488" height="182" as="geometry"/></mxCell><mxCell id="006" value="&lt;b&gt;Local buffer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;FIFO, retains 24 h at most, then drops and counts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="230" height="64" as="geometry"/></mxCell><mxCell id="007" value="" style="sketch=0;html=1;shape=mxgraph.networks.server;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="298" width="32" height="32" as="geometry"/></mxCell><mxCell id="node" value="&lt;b&gt;Autonomous node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ESP32-S3, IP67, LTE modem, encrypted flash&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="282" width="220" height="64" as="geometry"/></mxCell><mxCell id="008" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="307" y="298" width="32" height="32" as="geometry"/></mxCell><mxCell id="009" value="&lt;b&gt;Probes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;NPK, pH, soil, air and grain&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="354" width="230" height="64" as="geometry"/></mxCell><mxCell id="0010" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_hub;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="370" width="32" height="32" as="geometry"/></mxCell><mxCell id="0011" value="&lt;b&gt;Solar kit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;20 W panel, LiFePO4, 5 days of autonomy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="354" width="220" height="64" as="geometry"/></mxCell><mxCell id="0012" value="" style="sketch=0;html=1;shape=mxgraph.networks.server;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="307" y="370" width="32" height="32" as="geometry"/></mxCell><mxCell id="0013" value="Out-of-coverage vereda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6AA84F;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="46" y="444" width="488" height="118" as="geometry"/></mxCell><mxCell id="0014" value="Data mule&lt;br&gt;for objects" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="84" height="60" as="geometry"/></mxCell><mxCell id="lnode" value="&lt;b&gt;LoRa node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Same node, LoRa radio&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="154" y="474" width="170" height="72" as="geometry"/></mxCell><mxCell id="0015" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="161" y="494" width="32" height="32" as="geometry"/></mxCell><mxCell id="lgw" value="&lt;b&gt;Shared gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;High point, LTE backhaul&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="474" width="170" height="72" as="geometry"/></mxCell><mxCell id="0016" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_hub;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="357" y="494" width="32" height="32" as="geometry"/></mxCell><mxCell id="0018" value="Carriers: 60 phones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6AA84F;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="46" y="572" width="488" height="102" as="geometry"/></mxCell><mxCell id="carrier" value="&lt;b&gt;Carrier application&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Position every 5 min, queues offline, custody events always kept&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="460" height="62" as="geometry"/></mxCell><mxCell id="0019" value="" style="sketch=0;html=1;shape=mxgraph.networks.mobile;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="615" width="32" height="32" as="geometry"/></mxCell><mxCell id="0020" value="Drone service: 3 brigades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6AA84F;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="46" y="684" width="488" height="174" as="geometry"/></mxCell><mxCell id="0021" value="&lt;b&gt;Drone&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Mission preloaded, flight log held in its buffer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="460" height="62" as="geometry"/></mxCell><mxCell id="0022" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="727" width="32" height="32" as="geometry"/></mxCell><mxCell id="ground" value="&lt;b&gt;Ground station&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Loads missions at the municipal seat or center, uploads objects and logs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="782" width="460" height="62" as="geometry"/></mxCell><mxCell id="0023" value="" style="sketch=0;html=1;shape=mxgraph.networks.pc;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="797" width="32" height="32" as="geometry"/></mxCell><mxCell id="0024" value="C. Collection centers: one pattern, X = 41 Cauca, 42 Huila, 43 Tolima" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#D68910;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="46" y="870" width="488" height="424" as="geometry"/></mxCell><mxCell id="0025" value="&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;10.X.1.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="142" height="48" as="geometry"/></mxCell><mxCell id="0026" value="&lt;b&gt;Support&lt;/b&gt;&lt;br&gt;10.X.2.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="210" y="902" width="142" height="48" as="geometry"/></mxCell><mxCell id="0027" value="&lt;b&gt;Logistics&lt;/b&gt;&lt;br&gt;10.X.3.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="142" height="48" as="geometry"/></mxCell><mxCell id="0028" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;10.X.4.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="210" y="958" width="142" height="48" as="geometry"/></mxCell><mxCell id="0029" value="&lt;b&gt;Visitors, isolated&lt;/b&gt;&lt;br&gt;10.X.5.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="1014" width="142" height="48" as="geometry"/></mxCell><mxCell id="0030" value="&lt;b&gt;Local servers&lt;/b&gt;&lt;br&gt;10.X.10.0/24" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=0;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="210" y="1014" width="142" height="48" as="geometry"/></mxCell><mxCell id="0031" value="&lt;b&gt;WLAN and VLANs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;One SSID per zone, QoS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="902" width="164" height="64" as="geometry"/></mxCell><mxCell id="0032" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_hub;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="367" y="918" width="32" height="32" as="geometry"/></mxCell><mxCell id="0033" value="&lt;b&gt;Code printer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sheets for sacks with no code&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="974" width="164" height="64" as="geometry"/></mxCell><mxCell id="0034" value="" style="sketch=0;html=1;shape=mxgraph.networks.printer;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="367" y="990" width="32" height="32" as="geometry"/></mxCell><mxCell id="fw" value="&lt;b&gt;Perimeter firewall&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;10.X.20.0/24, default deny, one per center&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="1078" width="464" height="64" as="geometry"/></mxCell><mxCell id="0035" value="" style="sketch=0;html=1;shape=mxgraph.networks.firewall;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="1094" width="32" height="32" as="geometry"/></mxCell><mxCell id="0036" value="&lt;b&gt;WAN 100 Mbps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Symmetric, shared with operations&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="464" height="60" as="geometry"/></mxCell><mxCell id="0037" value="" style="sketch=0;html=1;shape=mxgraph.networks.router;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="67" y="1164" width="32" height="32" as="geometry"/></mxCell><mxCell id="0038" value="Visitors reach the internet only. Logistics and local servers reach the cloud through the tunnel." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="1218" width="464" height="62"