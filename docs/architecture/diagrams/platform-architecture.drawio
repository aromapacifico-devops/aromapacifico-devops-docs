t;b&gt;Workload accounts.&lt;/b&gt; Each one sends its own events. Its roles hold no write access to the archive." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="820" width="580" height="50" as="geometry"/></mxCell><mxCell id="1122" value="1 Read a sack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="src_app" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1123" value="2 Change a threshold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="src_op" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="312"/><mxPoint x="330" y="188"/></Array></mxGeometry></mxCell><mxCell id="1124" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="api" target="fn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1125" value="Audit event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="fn" target="lg_app"><mxGeometry 