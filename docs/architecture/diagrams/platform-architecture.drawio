ounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1650" y="560" width="150" height="64" as="geometry"/></mxCell><mxCell id="1121" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="1657" y="576" width="32" height="32" as="geometry"/></mxCell><mxCell id="1140" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="560" height="140" as="geometry"/></mxCell><mxCell id="1142" value="Platform events, sack reads, thresholds, URL grants" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="768" width="486" height="20" as="geometry"/></mxCell><mxCell id="1144" value="Telemetry publications" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="790" width="486" height="20" as="geometry"/></mxCell><mxCell id="1146" value="Flight object delivery" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="812" width="486" height="20" as="geometry"/></mxCell><mxCell id="1148" value="CloudTrail data events" styl