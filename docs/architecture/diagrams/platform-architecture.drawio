7" value="&lt;b&gt;Data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="279" width="150" height="30" as="geometry"/></mxCell><mxCell id="0648" value="Real, after the pilot starts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="279" width="400" height="30" as="geometry"/></mxCell><mxCell id="0649" value="&lt;b&gt;In code&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="314" width="150" height="30" as="geometry"/></mxCell><mxCell id="0650" value="Variables and plan, apply needs approval" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="314" width="400" height="30" as="geometry"/></mxCell><mxCell id="0651" value="&lt;b&gt;Stays up&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="349" width="150" height="30" as="geometry"/></mxCell><mxCell id="0652" value="Hours in the lab, always in the pilot" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="349" width="400" height="30" as="geometry"/></mxCell><mxCell id="0653" value="Controlled promotion: a change moves through the same pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B3D91;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="1780" height="200" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;fmt, validate, security scan, cross review&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Version tag on the module&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="310" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Plan and apply test&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tag updated in envs/test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Smoke test on test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="810" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Plan production&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tag updated in envs/prod&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Person approves&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Protected environment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1310" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Apply production&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OIDC role, outside the freeze&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1560" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="0660" value="Rollback: point the root of the environment to the previous module tag and run the same pipeline. The state and the Git history keep what was deployed. No production change between 05:00 and 18:00 in a harvest week, except during an incident." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1740" height="40" as="geometry"/></mxCell><mxCell id="0661" value="Bring up and down: credits are spent only while an environment is in use" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B3D91;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1780" height="230" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Bootstrap, once&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;State buckets and OIDC roles, never destroyed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Deploy workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manual, choose the environment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="412" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;Environment up&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;About USD 0.09 an hour with VPN and endpoints&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="764" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u4" value="&lt;b&gt;Destroy workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manual, or each night&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1116" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u5" value="&lt;b&gt;Environment down&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Only bootstrap remains, near zero&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1468" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="0667" value="Switches turn off the VPN and the interface endpoints when a session does not need them. Forgotten for a month, a full environment would burn about USD 60, which is why the nightly destroy exists." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="1740" height="44" as="geometry"/></mxCell><mxCell id="0668" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="700" height="74" as="geometry"/></mxCell><mxCell id="0670" value="Pipeline step" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="906" width="626" height="20" as="geometry"/></mxCell><mxCell id="0672" value="Next session starts again" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="928" width="626" height="20" as="geometry"/></mxCell><mxCell id="0673" value="The lab uses one credit account for every environment, with no AWS Organization, because joining one moves a free account to the paid plan. The target design keeps the seven accounts. Azure stays undeployed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="878" width="1060" height="74" as="geometry"/></mxCell><mxCell id="0654" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0655" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0656" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0657" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0658" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0659" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0662" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0663" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0664" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0665" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0666" value="next session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundCo