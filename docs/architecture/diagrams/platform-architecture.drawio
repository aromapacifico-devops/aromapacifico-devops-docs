=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1232" y="1236" width="170" height="66" as="geometry"/></mxCell><mxCell id="00118" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1239" y="1253" width="32" height="32" as="geometry"/></mxCell><mxCell id="00119" value="&lt;b&gt;Operations dashboard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;WAN, objects, silent nodes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1412" y="1236" width="170" height="66" as="geometry"/></mxCell><mxCell id="00120" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1419" y="1253" width="32" height="32" as="geometry"/></mxCell><mxCell id="00121" value="&lt;b&gt;Cost dashboard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Split by tags&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1592" y="1236" width="170" height="66" as="geometry"/></mxCell><mxCell id="00122" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;" vertex="1" parent="1"><mxGeometry x="1599" y="1253" width="32" height="32" as="geometry"/></mxCell><mxCell id="00123" value="&lt;b&gt;Two SLOs.&lt;/b&gt; Crop alert delivery and sack query availability. Alarms cover silent nodes over 24 h, unclosed flights and failed invocations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17A589;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1232" y="1316" width="530" height="66" as="geometry"/></mxCell><mxCell id="00124" value="D6. Test and development" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1790" y="1204" width="384" height="202" as="geometry"/></mxCell><mxCell id="00125" value="Same code, separate accounts and address ranges. Simulated nodes and synthetic data replace real sensors. Promotion goes development, test, production." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#566573;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1804" y="1236" width="356" height="146" as="geometry"/></mxCell><mxCell id="00126" value="E. Infrastructure delivery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="570" y="1436" width="1620" height="150" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;Module repositories&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&