 edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="998" as="sourcePoint"/><mxPoint x="718" y="998" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1557" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="1020" as="sourcePoint"/><mxPoint x="718" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1559" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="1042" as="sourcePoint"/><mxPoint x="718" y="1042" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="16 Fumigation order states"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2740" pageHeight="900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="161" value="Fumigation order states: from a confirmed focus to a closure that only a person can sign" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2660" height="34" as="geometry"/></mxCell><mxCell id="z1" value="Before authorization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="490" height="520" as="geometry"/></mxCell><mxCell id="z2" value="Authorized, no product applied" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="580" y="190" width="490" height="520" as="geometry"/></mxCell><mxCell id="z3" value="Application in the field, with no connection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1120" y="190" width="490" height="520" as="geometry"/></mxCell><mxCell id="z4" value="Record, verification and closure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1660" y="190" width="1040" height="520" as="geometry"/></mxCell><mxCell id="pre" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;PREREQUISITE_PENDING&lt;/font&gt;&lt;/b&gt;&lt;br&gt;order created&lt;br&gt;by a supervisor' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="ready" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;READY_FOR_HUMAN_REVIEW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;polygon, log, farmer&lt;br&gt;and permits checked' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;AUTHORIZED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;named supervisor,&lt;br&gt;second factor' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="pkg" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;PACKAGE_PRELOADED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;station and drone,&lt;br&gt;or brigade phone' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="860" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="exec" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;EXECUTING&lt;/font&gt;&lt;/b&gt;&lt;br&gt;inside the package&lt;br&gt;window' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1140" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="eps" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;EXECUTED_PENDING_SYNC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;log closed&lt;br&gt;in the field' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="frp" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;FLIGHT_RECORD_PERSISTED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;record verified,&lt;br&gt;planned product lot' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="vp" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;VERIFICATION_PENDING&lt;/font&gt;&lt;/b&gt;&lt;br&gt;stays open with&lt;br&gt;no verification file' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1980" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="ver" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;VERIFIED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;photos evaluated,&lt;br&gt;record written' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2240" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="closed" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;CLOSED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;outcome and any&lt;br&gt;follow-up order' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2500" y="260" width="170" height="76" as="geometry"/></mxCell><mxCell id="rej" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;REJECTED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;supervisor or&lt;br&gt;farmer refused' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#616161;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="170" height="76" as="geometry"/></mxCell><mxCell id="can" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;CANCELLED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;withdrawn&lt;br&gt;before takeoff' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#616161;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="170" height="76" as="geometry"/></mxCell><mxCell id="exp" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;EXPIRED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;window ended,&lt;br&gt;no product applied' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#616161;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="170" height="76" as="geometry"/></mxCell><mxCell id="blk" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;BLOCKED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;safety condition&lt;br&gt;failed' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="170" height="76" as="geometry"/></mxCell><mxCell id="abo" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;ABORTED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;applicator stopped&lt;br&gt;the application' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="170" height="76" as="geometry"/></mxCell><mxCell id="par" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;PARTIAL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;part of the area&lt;br&gt;treated' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="480" width="170" height="76" as="geometry"/></mxCell><mxCell id="syn" value='&lt;b&gt;&lt;font style="font-size:10px"&gt;SYNC_REVIEW_REQUIRED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;failed check or&lt;br&gt;other product lot' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="480" width="170" height="76" as="geometry"/></mxCell><mxCell id="1630" value="revise" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A1B9A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="130" y="514" width="60" height="20" as="geometry"/></mxCell><mxCell id="1631" value="retry" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A1B9A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1268" y="420" width="60" height="20" as="geometry"/></mxCell><mxCell id="1632" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="560" height="118" as="geometry"/></mxCell><mxCell id="1634" value="Platform function, conditional write" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="768" width="486" height="20" as="geometry"/></mxCell><mxCell id="1636" value="Person, with the group and second factor checked" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="790" width="486" height="20" as="geometry"/></mxCell><mxCell id="1638" value="Safety stop or failure" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="812" width="486" height="20" as="geometry"/></mxCell><mxCell id="1640" value="Scheduler at the end of the window" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="834" width="486" height="20" as="geometry"/></mxCell><mxCell id="1641" value="&lt;b&gt;Only a supervisor&lt;/b&gt; moves an order to AUTHORIZED or CLOSED, and only the supervisor or the farmer to REJECTED. No model, function, event or upload can authorize." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="640" y="740" width="640" height="60" as="geometry"/></mxCell><mxCell id="1642" value="&lt;b&gt;Not drawn.&lt;/b&gt; READY_FOR_HUMAN_REVIEW expires when its proposed window ends. ABORTED expires when no product left the tank. BLOCKED and EXPIRED can be revised or cancelled, and READY, AUTHORIZED and PACKAGE_PRELOADED can be revised. All 41 moves are in fumigation-order-transitions.json." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="740" width="860" height="76" as="geometry"/></mxCell><mxCell id="1643" value="&lt;b&gt;Audit.&lt;/b&gt; Every move, allowed or denied, writes one fumigation.transition event to the log archive." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2220" y="740" width="480" height="60" as="geometry"/></mxCell><mxCell id="162" value="checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="pre" target="ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="163" value="authorizes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="ready" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="164" value="both acks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strok