<mxGeometry x="810" y="244" width="400" height="30" as="geometry"/></mxCell><mxCell id="0630" value="&lt;b&gt;Data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="279" width="150" height="30" as="geometry"/></mxCell><mxCell id="0631" value="Synthetic readings, one sample farm" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="810" y="279" width="400" height="30" as="geometry"/></mxCell><mxCell id="0632" value="&lt;b&gt;In code&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="314" width="150" height="30" as="geometry"/></mxCell><mxCell id="0633" value="Variables and plan, applied in the lab" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="810" y="314" width="400" height="30" as="geometry"/></mxCell><mxCell id="0634" value="&lt;b&gt;Stays up&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="349" width="150" height="30" as="geometry"/></mxCell><mxCell id="0635" value="Hours, destroyed every night" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="810" y="349" width="400" height="30" as="geometry"/></mxCell><mxCell id="0636" value="Production" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="580" height="330" as="geometry"/></mxCell><mxCell id="0637" value="&lt;b&gt;Purpose&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="104" width="150" height="30" as="geometry"/></mxCell><mxCell id="0638" value="The pilot" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="104" width="400" height="30" as="geometry"/></mxCell><mxCell id="0639" value="&lt;b&gt;Target account&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="139" width="150" height="30" as="geometry"/></mxCell><mxCell id="0640" value="Production" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="139" width="400" height="30" as="geometry"/></mxCell><mxCell id="0641" value="&lt;b&gt;Lab account&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="174" width="150" height="30" as="geometry"/></mxCell><mxCell id="0642" value="Shared credit account" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="174" width="400" height="30" as="geometry"/></mxCell><mxCell id="0643" value="&lt;b&gt;Range&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="209" width="150" height="30" as="geometry"/></mxCell><mxCell id="0644" value="10.70.0.0/16" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="209" width="400" height="30" as="geometry"/></mxCell><mxCell id="0645" value="&lt;b&gt;Zones&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="244" width="150" height="30" as="geometry"/></mxCell><mxCell id="0646" value="Two" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="244" width="400" height="30" as="geometry"/></mxCell><mxCell id="0647" value="&lt;b&gt;Data&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="279" width="150" height="30" as="geometry"/></mxCell><mxCell id="0648" value="Real, after the pilot starts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="279" width="400" height="30" as="geometry"/></mxCell><mxCell id="0649" value="&lt;b&gt;In code&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="314" width="150" height="30" as="geometry"/></mxCell><mxCell id="0650" value="Variables and plan, apply needs approval" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="314" width="400" height="30" as="geometry"/></mxCell><mxCell id="0651" value="&lt;b&gt;Stays up&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1256" y="349" width="150" height="30" as="geometry"/></mxCell><mxCell id="0652" value="Hours in the lab, always in the pilot" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1410" y="349" width="400" height="30" as="geometry"/></mxCell><mxCell id="0653" value="Controlled promotion: a change moves through the same pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B3D91;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="1780" height="200" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;fmt, validate, security scan, cross review&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Version tag on the module&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="310" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Plan and apply test&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tag updated in envs/test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Smoke test on test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="810" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;Plan production&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Tag updated in envs/prod&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;Person approves&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Protected environment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1310" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Apply production&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OIDC role, outside the freeze&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1560" y="462" width="218" height="84" as="geometry"/></mxCell><mxCell id="0660" value="Rollback: point the root of the environment to the previous module tag and run the same pipeline. The state and the Git history keep what was deployed. No production change between 05:00 and 18:00 in a harvest week, except during an incident." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1740" height="40" as="geometry"/></mxCell><mxCell id="0661" value="Bring up and down: credits are spent only while an environment is in use" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B3D91;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1780" height="230" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Bootstrap, once&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;State buckets and OIDC roles, never destroyed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Deploy workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manual, choose the environment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="412" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;Environment up&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;About USD 0.09 an hour with VPN and endpoints&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="764" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u4" value="&lt;b&gt;Destroy workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manual, or each night&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1116" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="u5" value="&lt;b&gt;Environment down&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Only bootstrap remains, near zero&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1468" y="676" width="310" height="84" as="geometry"/></mxCell><mxCell id="0667" value="Switches turn off the VPN and the interface endpoints when a session does not need them. Forgotten for a month, a full environment would burn about USD 60, which is why the nightly destroy exists." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="1740" height="44" as="geometry"/></mxCell><mxCell id="0668" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="700" height="74" as="geometry"/></mxCell><mxCell id="0670" value="Pipeline step" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="906" width="626" height="20" as="geometry"/></mxCell><mxCell id="0672" value="Next session starts again" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="928" width="626" height="20" as="geometry"/></mxCell><mxCell id="0673" value="The lab uses one credit account for every environment, with no AWS Organization, because joining one moves a free account to the paid plan. The target design keeps the seven accounts. Azure stays undeployed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="878" width="1060" height="74" as="geometry"/></mxCell><mxCell id="0654" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0655" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0656" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0657" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0658" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0659" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0662" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0663" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0664" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0665" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0666" value="next session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="u5" target="u2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1604" y="790"/><mxPoint x="567" y="790"/></Array></mxGeometry></mxCell><mxCell id="0669" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="916" as="sourcePoint"/><mxPoint x="98" y="916" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0671" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="938" as="sourcePoint"/><mxPoint x="98" y="938" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="07 Farm connection sequence"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1280" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="071" value="How a farm node connects, loses its link and recovers, with no reading lost silently" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="34" as="geometry"/></mxCell><mxCell id="072" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1480" height="372" as="geometry"/></mxCell><mxCell id="073" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="1480" height="276" as="geometry"/></mxCell><mxCell id="074" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="1480" height="288" as="geometry"/></mxCell><mxCell id="075" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="249" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="076" value="&lt;b&gt;Farm node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Controller, flash buffer, LTE modem&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="155" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="077" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="162" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="078" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="609" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="079" value="&lt;b&gt;Mobile network&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Attach and network time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="515" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0710" value="" style="sketch=0;html=1;shape=mxgraph.networks.radio_tower;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="522" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0711" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="859" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0712" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Broker, rule and shadow&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="765" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0713" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="772" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0714" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1119" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0715" value="&lt;b&gt;Queue and function&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;SQS, ingestion function&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1025" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0716" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1032" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0717" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1389" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0718" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Readings and alert state&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1295" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0719" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1302" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0720" value="Connection, each hour at the minute fixed for the node" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF6EC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="146" width="470" height="24" as="geometry"/></mxCell><mxCell id="0721" value="Disconnection, a failure at any step ends the same way" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#FDEDEC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="470" height="24" as="geometry"/></mxCell><mxCell id="0722" value="Recovery, the signal returns" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF2F8;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="818" width="470" height="24" as="geometry"/></mxCell><mxCell id="0723" value="&lt;b&gt;Wake.&lt;/b&gt; Read if due, append record with seq and measured_at, delete records of 24 h or more" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="176" width="360" height="44" as="geometry"/></mxCell><mxCell id="0735" value="&lt;b&gt;No path.&lt;/b&gt; Records stay. The next hour is the retry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="360" height="34" as="geometry"/></mxCell><mxCell id="0740" value="&lt;b&gt;No PUBACK in 10 s.&lt;/b&gt; Record stays, modem off, sleep until the next hour" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="360" height="34" as="geometry"/></mxCell><mxCell id="0741" value="&lt;b&gt;At 24 h.&lt;/b&gt; A record still waiting is deleted, and dropped_total grows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="746" width="360" height="34" as="geometry"/></mxCell><mxCell id="0751" value="&lt;b&gt;Alerts.&lt;/b&gt; Only a newer measured_at changes the alert state. An alert from an old reading carries the time of that reading" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="1020" width="540" height="44" as="geometry"/></mxCell><mxCell id="0753" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="560" height="140" as="geometry"/></mxCell><mxCell id="0755" value="Reading and its confirmation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1144" width="486" height="20" as="geometry"/></mxCell><mxCell id="0757" value="Configuration through the shadow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1166" width="486" height="20" as="geometry"/></mxCell><mxCell id="0759" value="Connection control" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1188" width="486" height="20" as="geometry"/></mxCell><mxCell id="0761" value="Failure or rejection" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1210" width="486" height="20" as="geometry"/></mxCell><mxCell id="0763" value="Dashed line, an answer to a request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1232" width="486" height="20" as="geometry"/></mxCell><mxCell id="0724" value="Attach, network time" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="240" as="sourcePoint"/><mxPoint x="610" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0725" value="TLS, CONNECT clean session" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="274" as="sourcePoint"/><mxPoint x="860" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0726" value="CONNACK" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="308" as="sourcePoint"/><mxPoint x="250" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0727" value="PUBLISH QoS 1, oldest first, 10 unconfirmed at most" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="342" as="sourcePoint"/><mxPoint x="860" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0728" value="Rule adds received_at" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="342" as="sourcePoint"/><mxPoint x="1120" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0729" value="Conditional write" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="342" as="sourcePoint"/><mxPoint x="1390" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0730" value="PUBACK, record leaves the buffer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="376" as="sourcePoint"/><mxPoint x="250" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0731" value="Get shadow" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="410" as="sourcePoint"/><mxPoint x="860" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0732" value="Desired state, drying on or off" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="444" as="sourcePoint"/><mxPoint x="250" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0733" value="DISCONNECT, then modem off and sleep" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="478" as="sourcePoint"/><mxPoint x="860" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0734" value="Attach fails, window of 120 s ends" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="572" as="sourcePoint"/><mxPoint x="610" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0736" value="PUBLISH seq n" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="640" as="sourcePoint"/><mxPoint x="860" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0737" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="640" as="sourcePoint"/><mxPoint x="1120" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0738" value="Stored" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="640" as="sourcePoint"/><mxPoint x="1390" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0739" value="PUBACK lost" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="674" as="sourcePoint"/><mxPoint x="540" y="674" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0742" value="Attach, signal is back" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="850" as="sourcePoint"/><mxPoint x="610" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0743" value="PUBLISH seq n, repeat, buffered true" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="886" as="sourcePoint"/><mxPoint x="860" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0744" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="886" as="sourcePoint"/><mxPoint x="1120" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0745" value="Conditional write" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="886" as="sourcePoint"/><mxPoint x="1390" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0746" value="Rejected, already stored" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="920" as="sourcePoint"/><mxPoint x="1120" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0747" value="PUBACK, record leaves the buffer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="954" as="sourcePoint"/><mxPoint x="250" y="954" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0748" value="PUBLISH seq n+1 and newer, buffered true" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="988" as="sourcePoint"/><mxPoint x="860" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0749" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="988" as="sourcePoint"/><mxPoint x="1120" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0750" value="Stored, state if newer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="988" as="sourcePoint"/><mxPoint x="1390" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0752" value="Get shadow, DISCONNECT, sleep" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="1064" as="sourcePoint"/><mxPoint x="860" y="1064" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0754" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1154" as="sourcePoint"/><mxPoint x="98" y="1154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0756" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1176" as="sourcePoint"/><mxPoint x="98" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0758" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1198" as="sourcePoint"/><mxPoint x="98" y="1198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0760" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1220" as="sourcePoint"/><mxPoint x="98" y="1220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0762" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1242" as="sourcePoint"/><mxPoint x="98" y="1242" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="08 Sack state model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="830" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="081" value="Sack states and transitions: from the farm to the port, and what a rejection does" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="34" as="geometry"/></mxCell><mxCell id="082" value="Farm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="480" as="geometry"/></mxCell><mxCell id="083" value="Road to the center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="280" height="480" as="geometry"/></mxCell><mxCell id="084" value="Collection center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="310" height="480" as="geometry"/></mxCell><mxCell id="085" value="Road to the port" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="280" height="480" as="geometry"/></mxCell><mxCell id="086" value="Port of Buenaventura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#E65100;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="310" height="480" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;in_preparation&lt;/b&gt;&lt;br&gt;Farmer holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="190" height="70" as="geometry"/></mxCell><mxCell id="toc" value="&lt;b&gt;in_transit_to_center&lt;/b&gt;&lt;br&gt;Carrier holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="385" y="280" width="190" height="70" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;at_center_accepted&lt;/b&gt;&lt;br&gt;Center holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;at_center_rejected&lt;/b&gt;&lt;br&gt;Resting state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="190" height="70" as="geometry"/></mxCell><mxCell id="top" value="&lt;b&gt;in_transit_to_port&lt;/b&gt;&lt;br&gt;Carrier holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="985" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;delivered_accepted&lt;/b&gt;&lt;br&gt;End of the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1285" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="no" value="&lt;b&gt;delivered_rejected&lt;/b&gt;&lt;br&gt;End of the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1285" y="240" width="190" height="70" as="geometry"/></mxCell><mxCell id="s1" value="Start at the farm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="52" y="120" width="105" height="56" as="geometry"/></mxCell><mxCell id="s2" value="Start at the center, no code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="175" y="120" width="115" height="56" as="geometry"/></mxCell><mxCell id="0816" value="Correct to rejected, with reason" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="84" height="60" as="geometry"/></mxCell><mxCell id="0817" value="Correct to accepted, with reason" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="792" y="290" width="100" height="60" as="geometry"/></mxCell><mxCell id="0820" value="delivered_accepted" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1090" y="150" width="130" height="22" as="geometry"/></mxCell><mxCell id="0822" value="delivered_rejected" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1090" y="250" width="130" height="22" as="geometry"/></mxCell><mxCell id="0824" value="&lt;b&gt;The history keeps every event.&lt;/b&gt; Arrival, pickup, reweighing, label reprint and a missing report change no state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1225" y="400" width="280" height="66" as="geometry"/></mxCell><mxCell id="0825" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="560" height="118" as="geometry"/></mxCell><mxCell id="0827" value="Normal path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="594" width="486" height="20" as="geometry"/></mxCell><mxCell id="0829" value="Rejection and return" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="616" width="486" height="20" as="geometry"/></mxCell><mxCell id="0831" value="Correction, before the sack leaves the center" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="638" width="486" height="20" as="geometry"/></mxCell><mxCell id="0833" value="Only a sack registered at the center" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="660" width="486" height="20" as="geometry"/></mxCell><mxCell id="0834" value="&lt;b&gt;Applied.&lt;/b&gt; The event fits the history, and the state moves." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0835" value="&lt;b&gt;Gap.&lt;/b&gt; An earlier event is missing. The state moves, and the late event closes the gap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0836" value="&lt;b&gt;Anomaly.&lt;/b&gt; The event contradicts the history. It is kept for review, and the state stays." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1220" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0837" value="&lt;b&gt;Order.&lt;/b&gt; The state comes from replaying the history by time of capture, so any arrival order gives the same result." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="646" width="880" height="44" as="geometry"/></mxCell><mxCell id="087" value="registered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="088" value="registered_at_center" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="089" value="handed_to_carrier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="prep" target="toc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0810" value="received_accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toc" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="301"/><mxPoint x="615" y="205"/></Array></mxGeometry></mxCell><mxCell id="0811" value="received_rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toc" target="rej"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="329"/><mxPoint x="615" y="435"/></Array></mxGeometry></mxCell><mxCell id="0812" value="reception, sack with no code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prep" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="290"/><mxPoint x="305" y="145"/><mxPoint x="745" y="145"/></Array></mxGeometry></mxCell><mxCell id="0813" value="reception, sack with no code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prep" target="rej"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="340"/><mxPoint x="305" y="490"/><mxPoint x="688" y="490"/></Array></mxGeometry></mxCell><mxCell id="0814" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0815" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rej" target="acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0818" value="dispatched_to_port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="acc" target="top"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0819" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="top" target="ok"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="191"/><mxPoint x="1235" y="145"/></Array></mxGeometry></mxCell><mxCell id="0821" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="top" target="no"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="219"/><mxPoint x="1235" y="275"/></Array></mxGeometry></mxCell><mxCell id="0823" value="returned_to_farm, same code and same history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rej" target="prep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="520"/><mxPoint x="150" y="520"/></Array></mxGeometry></mxCell><mxCell id="0826" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="604" as="sourcePoint"/><mxPoint x="98" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0828" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="626" as="sourcePoint"/><mxPoint x="98" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0830" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="648" as="sourcePoint"/><mxPoint x="98" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0832" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="670" as="sourcePoint"/><mxPoint x="98" y="670" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="09 Center WLAN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="940" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="091" value="How the WLAN of a center is segmented: SSID, VLAN and what each zone may reach" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1620" height="34" as="geometry"/></mxCell><mxCell id="092" value="Wi-Fi clients and their SSID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="640" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Access points&lt;/b&gt;&lt;br&gt;2 to 3, powered by the switch&lt;br&gt;five SSIDs&lt;br&gt;one VLAN per SSID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="150" height="548" as="geometry"/></mxCell><mxCell id="z0" value="&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;AP-GER, VLAN 101&lt;br&gt;10.X.1.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="360" height="92" as="geometry"/></mxCell><mxCell id="z1" value="&lt;b&gt;Support&lt;/b&gt;&lt;br&gt;AP-SOP, VLAN 2&lt;br&gt;10.X.2.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="360" height="92" as="geometry"/></mxCell><mxCell id="z2" value="&lt;b&gt;Logistics&lt;/b&gt;&lt;br&gt;AP-LOG, VLAN 3&lt;br&gt;10.X.3.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="360" height="92" as="geometry"/></mxCell><mxCell id="z3" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;AP-TRA, VLAN 4&lt;br&gt;10.X.4.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="360" height="92" as="geometry"/></mxCell><mxCell id="z4" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;AP-VIS, VLAN 5&lt;br&gt;10.X.5.0/24, isolated clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="360" height="92" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;Managed switch&lt;/b&gt;&lt;br&gt;trunks carry only the listed VLANs&lt;br&gt;no routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="750" y="339" width="140" height="90" as="geometry"/></mxCell><mxCell id="fw" value="Perimeter firewall&lt;br&gt;gateway of every zone" style="sketch=0;html=1;shape=mxgraph.networks.firewall;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1040" y="358" width="52" height="52" as="geometry"/></mxCell><mxCell id="0910" value="Local servers, VLAN 10, wired only, 10.X.10.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="500" height="270" as="geometry"/></mxCell><mxCell id="prt" value="&lt;b&gt;Label printer&lt;/b&gt;&lt;br&gt;10.X.10.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="swm" value="&lt;b&gt;Switch&lt;/b&gt;&lt;br&gt;10.X.10.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="apm" value="&lt;b&gt;Access points&lt;/b&gt;&lt;br&gt;10.X.10.3 to .5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b&gt;Administration host&lt;/b&gt;&lt;br&gt;10.X.10.11 to .20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="0911" value="Each device accepts administration only from the administration host." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="net" value="Internet" style="sketch=0;html=1;shape=mxgraph.networks.cloud;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1290" y="358" width="80" height="52" as="geometry"/></mxCell><mxCell id="0916" value="Cloud, us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="480" width="500" height="210" as="geometry"/></mxCell><mxCell id="vgw" value="Virtual private&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="1"><mxGeometry x="1260" y="540" width="52" height="52" as="geometry"/></mxCell><mxCell id="eps" value="Private endpoints&lt;br&gt;API and S3" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1500" y="540" width="52" height="52" as="geometry"/></mxCell><mxCell id="0919" value="Four layers keep visitors apart, and each one stops them on its own" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="460" y="730" width="1200" height="180" as="geometry"/></mxCell><mxCell id="0920" value="&lt;b&gt;1. Access point.&lt;/b&gt; Client isolation on AP-VIS stops one visitor phone from reaching another." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="480" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0921" value="&lt;b&gt;2. VLAN and trunk.&lt;/b&gt; VLAN 5 exists only on the access point trunks and the firewall uplink, with no wired port." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0922" value="&lt;b&gt;3. Firewall.&lt;/b&gt; Deny toward every private range and toward the firewall itself, ahead of the internet allow. Only DHCP and DNS reach the gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0923" value="&lt;b&gt;4. Tunnel and cloud.&lt;/b&gt; No route for 10.X.5.0/24, and endpoint security groups accept only logistics and local servers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1350" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0924" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="400" height="118" as="geometry"/></mxCell><mxCell id="0926" value="Wi-Fi association, named by SSID" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="758" width="326" height="20" as="geometry"/></mxCell><mxCell id="0928" value="Wired trunk or administration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="780" width="326" height="20" as="geometry"/></mxCell><mxCell id="0930" value="Path the firewall allows" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="802" width="326" height="20" as="geometry"/></mxCell><mxCell id="0932" value="Rule defined, not enabled" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="824" width="326" height="20" as="geometry"/></mxCell><mxCell id="0933" value="&lt;b&gt;X is 41 Cauca, 42 Huila or 43 Tolima.&lt;/b&gt; Only logistics and local servers reach the cloud. No zone reaches another. The printing rule from logistics stays pending until address, protocol and port are confirmed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="400" height="70" as="geometry"/></mxCell><mxCell id="093" value="AP-GER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.08394160583941605;entryDx=0;entryDy=0;" edge="1" parent="1" source="z0" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="094" value="AP-SOP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2846715328467153;entryDx=0;entryDy=0;" edge="1" parent="1" source="z1" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="095" value="AP-LOG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4854014598540146;entryDx=0;entryDy=0;" edge="1" parent="1" source="z2" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="096" value="AP-TRA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6861313868613139;entryDx=0;entryDy=0;" edge="1" parent="1" source="z3" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="097" value="AP-VIS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8868613138686131;entryDx=0;entryDy=0;" edge="1" parent="1" source="z4" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="098" value="trunk, tagged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="sw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="099" value="trunk, all zone VLANs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sw" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0912" value="admin only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="swm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0913" value="admin only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="apm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="285"/></Array></mxGeometry></mxCell><mxCell id="0914" value="Printing rule, pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="prt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="363"/><mxPoint x="1125" y="165"/></Array></mxGeometry></mxCell><mxCell id="0915" value="HTTPS 443, visitors 80 and 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="net"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0917" value="IPsec VPN, logistics and local servers only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fw" target="vgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="405"/><mxPoint x="1125" y="566"/></Array></mxGeometry></mxCell><mxCell id="0918" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="vgw" target="eps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0925" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="768" as="sourcePoint"/><mxPoint x="98" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0927" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="790" as="sourcePoint"/><mxPoint x="98" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0929" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="812" as="sourcePoint"/><mxPoint x="98" y="812" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0931" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="834" as="sourcePoint"/><mxPoint x="98" y="834" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="10 Center operation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="101" value="How a collection center receives, labels and dispatches sacks, and what limits it at 400 sacks a day" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1620" height="34" as="geometry"/></mxCell><mxCell id="102" value="Reception: arrival is one action for the load, the decision is one event for each sack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1640" height="250" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;1. Load arrives&lt;/b&gt;&lt;br&gt;carrier, once&lt;br&gt;arrived_at_center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. Waiting area&lt;/b&gt;&lt;br&gt;sacks stay in transit&lt;br&gt;no event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. Scan the label&lt;/b&gt;&lt;br&gt;15 s, assumed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;4. Weigh&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;farm weight is kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;5. Inspect&lt;/b&gt;&lt;br&gt;90 s, assumed&lt;br&gt;no criteria invented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;6. Decide and record&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;reception weight, reason code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;7. Move the sack&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;stack or return area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1430" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Accepted&lt;/b&gt;&lt;br&gt;received_accepted&lt;br&gt;then dispatched_to_port, groups of 30, 15 s a sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="300" height="70" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;received_rejected&lt;br&gt;then returned_to_farm, same code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="215" width="250" height="70" as="geometry"/></mxCell><mxCell id="1011" value="The five reception steps add up to 165 s for each sack. The dispatch scan of 15 s makes 180 s and belongs to the dispatch station." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="480" height="70" as="geometry"/></mxCell><mxCell id="1012" value="A correction before dispatch is an event with a reason. Reasons are provisional codes with an observation, not approved criteria." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="215" width="450" height="70" as="geometry"/></mxCell><mxCell id="1013" value="Sack that arrives with no code: four steps, each one can fail alone and none creates a second sack or code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="1640" height="270" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;A. Assign a code&lt;/b&gt;&lt;br&gt;from the issued block of this device&lt;br&gt;20 s with B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;B. Register&lt;/b&gt;&lt;br&gt;registered_at_center&lt;br&gt;farm, weight, event_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;C. Print one label&lt;/b&gt;&lt;br&gt;30 s on the printer&lt;br&gt;never two identical labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#1565C0;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;D. Attach and scan&lt;/b&gt;&lt;br&gt;40 s&lt;br&gt;scan must match the registered code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="rcv" value="&lt;b&gt;Reception&lt;/b&gt;&lt;br&gt;steps 3 to 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1300" y="390" width="150" height="80" as="geometry"/></mxCell><mxCell id="1018" value="&lt;b&gt;If it fails.&lt;/b&gt; No code left in the block: stop, use another device or wait. No code is invented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1019" value="&lt;b&gt;If it fails.&lt;/b&gt; Event waits on the device and repeats with the same event_id. A second registration of the code is an anomaly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1020" value="&lt;b&gt;If it fails.&lt;/b&gt; No label came out: print again for the same code. It is a retry, not a reprint, and it makes no sack and no code." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1021" value="&lt;b&gt;If it fails.&lt;/b&gt; Mismatch: stop the sack, void the label, print again as a reprint with the same code." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1022" value="&lt;b&gt;Printing rule pending.&lt;/b&gt; Address, protocol and port of the printer are not confirmed, so no permission is opened. A receipt, if any, is a separate non-adhesive slip with no QR." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1300" y="490" width="350" height="100" as="geometry"/></mxCell><mxCell id="1023" value="Work with no internet and reprints" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="810" height="330" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Reserve of the center&lt;/b&gt;&lt;br&gt;10 percent of 400 sacks for 2 days = 80 codes, assumed&lt;br&gt;sized first, issued in advance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="300" height="80" as="geometry"/></mxCell><mxCell id="blk" value="&lt;b&gt;Exclusive blocks&lt;/b&gt;&lt;br&gt;no overlap, one per device&lt;br&gt;40 + 40, or 27 + 27 + 26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="250" height="80" as="geometry"/></mxCell><mxCell id="1025" value="&lt;b&gt;Exhausted:&lt;/b&gt; stop. &lt;b&gt;Lost device:&lt;/b&gt; freeze its codes, never reuse. &lt;b&gt;Link back:&lt;/b&gt; events arrive, gaps close, new block issued, 48 h review list." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="600" height="70" as="geometry"/></mxCell><mxCell id="1026" value="&lt;b&gt;Reprint:&lt;/b&gt; same code, reason, label_reprinted, old label withdrawn or voided when possible. Review from the third reprint is an operating assumption." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="885" width="600" height="70" as="geometry"/></mxCell><mxCell id="1027" value="Capacity at 400 sacks a day, assumed times, not measured" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="870" y="640" width="800" height="370" as="geometry"/></mxCell><mxCell id="cap" value="&lt;b&gt;Busiest hour&lt;/b&gt;&lt;br&gt;150 sacks, 3 times the average of 50&lt;br&gt;9 stations at 85 percent leave no queue&lt;br&gt;4 people complete the day, 63 sacks queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="690" width="360" height="90" as="geometry"/></mxCell><mxCell id="bot" value="&lt;b&gt;Bottleneck: inspection&lt;/b&gt;&lt;br&gt;48 percent of the person time of a sack&lt;br&gt;5 people inspecting in the busiest hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1280" y="690" width="370" height="90" as="geometry"/></mxCell><mxCell id="1028" value="&lt;b&gt;People, not devices.&lt;/b&gt; 2 desktops and 20 phones do not show enough people, scales or inspection pace. With 4 people the backlog is 63 sacks after the busiest hour." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="800" width="360" height="80" as="geometry"/></mxCell><mxCell id="1029" value="&lt;b&gt;One scale&lt;/b&gt; runs at 83 percent in the busiest hour. &lt;b&gt;One printer&lt;/b&gt; is busy 19 percent with 10 percent of sacks with no code and 5 percent reprints." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1280" y="800" width="370" height="80" as="geometry"/></mxCell><mxCell id="1030" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="895" width="360" height="96" as="geometry"/></mxCell><mxCell id="1032" value="Normal path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="923" width="286" height="20" as="geometry"/></mxCell><mxCell id="1034" value="Rejection or failure" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="945" width="286" height="20" as="geometry"/></mxCell><mxCell id="1036" value="Step that depends on the pending printing rule" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="967" width="286" height="20" as="geometry"/></mxCell><mxCell id="103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t6" target="t7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="109" value="accept" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t6" target="acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1010" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t6" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1014" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1015" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1016" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1017" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="rcv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1024" value="split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E65100;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="blk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1031" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="902" y="933" as="sourcePoint"/><mxPoint x="948" y="933" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1033" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="902" y="955" as="sourcePoint"/><mxPoint x="948" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1035" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="902" y="977" as="sourcePoint"/><mxPoint x="948" y="977" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>