 node&lt;/b&gt;&lt;br&gt;node_id, farm_id&lt;br&gt;lot_id, drying_lot_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="260" height="90" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;IoT Core&lt;/b&gt;&lt;br&gt;trace_id in the audit log&lt;br&gt;I-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="230" height="90" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Ingestion queue&lt;/b&gt;&lt;br&gt;I-02 depth and age&lt;br&gt;I-03 dead letter queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="670" y="380" width="250" height="90" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Ingestion function&lt;/b&gt;&lt;br&gt;reading_id, correlation_id&lt;br&gt;I-04, I-05, I-09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="290" height="90" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Tables and alerts&lt;/b&gt;&lt;br&gt;I-06 handoff time&lt;br&gt;I-07, I-08 delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1330" y="380" width="270" height="90" as="geometry"/></mxCell><mxCell id="2014" value="LoRa farms: I-13 silent vereda and I-14 gaps in the stored sequences. I-01 reads silent nodes over 24 hours." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="485" width="800" height="45" as="geometry"/></mxCell><mxCell id="2015" value="lot_id is the farm lot and drying_lot_id is the drying lot. Neither stands for the other." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="485" width="700" height="45" as="geometry"/></mxCell><mxCell id="2016" value="Flight: mission, execution and record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1640" height="230" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Ground station&lt;/b&gt;&lt;br&gt;mission_id, package_id&lt;br&gt;execution_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="260" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Upload function&lt;/b&gt;&lt;br&gt;F-01 flight_object.authorized&lt;br&gt;F-02 expired URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="230" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Flight object bucket&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;10 prefixes, events, quarantine, F-06&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="670" y="640" width="250" height="90" as="geometry"/></mxCell><mxCell id="2017" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="677" y="669" width="32" height="32" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Verification&lt;/b&gt;&lt;br&gt;F-03 hash against manifest&lt;br&gt;completion rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="980" y="640" width="290" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Order and record&lt;/b&gt;&lt;br&gt;order_id, case_id, record_id&lt;br&gt;F-04, F-05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1330" y="640" width="270" height="90" as="geometry"/></mxCell><mxCell id="2022" value="&lt;b&gt;Flight objects.&lt;/b&gt; S3 sends Object Created to EventBridge and the verification queue. The function publishes verified or rejected, and completion publishes the record or sends it to review. F-06 reads these outcomes by execution." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#1565C0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="1540" height="55" as="geometry"/></mxCell><mxCell id="2023" value="Where the records go" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="1100" height="130" as="geometry"/></mxCell><mxCell id="2024" value="&lt;b&gt;Operational logs.&lt;/b&gt; Structured JSON, identifiers as fields and never as metric dimensions, kept 30 days. Nothing personal and no secret." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="520" height="65" as="geometry"/></mxCell><mxCell id="2025" value="&lt;b&gt;Audit logs.&lt;/b&gt; Their own groups, 90 days in CloudWatch and five years in S3. Unchanged by this design." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="590" y="890" width="520" height="65" as="geometry"/></mxCell><mxCell id="2026" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="840" width="510" height="74" as="geometry"/></mxCell><mxCell id="2028" value="Path of the record or the event" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1226" y="868" width="436" height="20" as="geometry"/></mxCell><mxCell id="2030" value="Upload path of a flight object" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1226" y="890" width="436" height="20" as="geometry"/></mxCell><mxCell id="203" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;s