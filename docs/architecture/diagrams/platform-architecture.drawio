lColor=none;strokeColor=#879196;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="460" height="104" as="geometry"/></mxCell><mxCell id="034" value="Publishes on schedule. Buffer retains 24 h at most, and the alert goes out when it drains." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="138" width="350" height="64" as="geometry"/></mxCell><mxCell id="n1" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="142" width="52" height="52" as="geometry"/></mxCell><mxCell id="035" value="Farm out of coverage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="460" height="104" as="geometry"/></mxCell><mxCell id="036" value="LoRa reaches the shared gateway. Objects travel by data mule on daily routes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="258" width="350" height="64" as="geometry"/></mxCell><mxCell id="n2" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="262" width="52" height="52" as="geometry"/></mxCell><mxCell id="037" value="Drone at the lot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="460" height="104" as="geometry"/></mxCell><mxCell id="038" value="Mission preloaded. Flight log stays in the buffer. Fumigation stays unauthorized until the log closes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="378" width="350" height="64" as="geometry"/></mxCell><mxCell id="n3" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="382" width="52" height="52" as="geometry"/></mxCell><mxCell id="039" value="Carrier in transit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="460" height="104" as="geometry"/></mxCell><mxCell id="0310" value="Position every 5 min. Queues positions, and custody events are always kept." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="498" width="350" height="64" as="geometry"/></mxCell><mxCell id="n4" value="" style="sketch=0;html=1;shape=mxgraph.networks.mobile;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="502" width="36" height="52" as="geometry"/></mxCell><mxCell id="0311" value="Port of Buenaventura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#879196;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="460" height="104" as="geometry"/></mxCell><mxCell id="0312" value="No Federation equipment. Only the sack delivery event is recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="72" y="618" width="350" height="64" as="geometry"/></mxCell><mxCell id="n5" value="" style="sketch=0;html=1;shape=mxgraph.networks.mobile;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="450" y="622" width="36" height="52" as="geometry"/></mxCell><mxCell id="0313" value="Cloud endpoints, us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="220" height="620" as="geometry"/></mxCell><mxCell id="iot" value="IoT Core" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="734" y="130" width="52" height="52" as="geometry"/></mxCell><mxCell id="api" value="API Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="734" y="480" width="52" height="52" as="geometry"/></mxCell><mxCell id="gw" value="Shared LoRaWAN&lt;br&gt;gateway" style="sketch=0;html=1;shape=mxgraph.networks.wireless_hub;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="570" y="256" width="44" height="44" as="geometry"/></mxCell><mxCell id="0319" value="Collection center pattern, repeated three times. X is 41 Cauca, 42 Huila or 43 Tolima" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="900" y="70" width="920" height="620" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;LAN and WLAN&lt;/b&gt;&lt;br&gt;one VLAN and one SSID per zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="120" height="548" as="geometry"/></mxCell><mxCell id="z0" value="&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;10.X.1.0/24&lt;br&gt;2 desktops, 5 phones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="110" width="200" height="84" as="geometry"/></mxCell><mxCell id="z1" value="&lt;b&gt;Support&lt;/b&gt;&lt;br&gt;10.X.2.0/24&lt;br&gt;2 desktops, 5 phones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="204" width="200" height="84" as="geometry"/></mxCell><mxCell id="z2" value="&lt;b&gt;Logistics&lt;/b&gt;&lt;br&gt;10.X.3.0/24&lt;br&gt;2 desktops, 20 phones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="298" width="200" height="84" as="geometry"/></mxCell><mxCell id="z3" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;10.X.4.0/24&lt;br&gt;20 phones in the yard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="392" width="200" height="84" as="geometry"/></mxCell><mxCell id="z4" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;10.X.5.0/24&lt;br&gt;10 phones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="486" width="200" height="84" as="geometry"/></mxCell><mxCell id="z5" value="&lt;b&gt;Local servers&lt;/b&gt;&lt;br&gt;10.X.10.0/24&lt;br&gt;Printing, network control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="580" width="200" height="84" as="geometry"/></mxCell><mxCell id="fw" value="Perimeter firewall&lt;br&gt;10.X.20.0/24" style="sketch=0;html=1;shape=mxgraph.networks.firewall;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1385" y="356" width="52" height="52" as="geometry"/></mxCell><mxCell id="0327" value="&lt;b&gt;Isolation.&lt;/b&gt; Visitors route to the internet only, with no path to logistics or management." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="110" width="160" height="110" as="geometry"/></mxCell><mxCell id="0328" value="&lt;b&gt;Tunnel routes.&lt;/b&gt; Only 10.X.3.0/24 and 10.X.10.0/24 reach the cloud. Other zones use the internet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="232" width="160" height="104" as="geometry"/></mxCell><mxCell id="0329" value="&lt;b&gt;Capacity.&lt;/b&gt; 100 Mbps symmetric WAN. Up to 40 active clients at 2 Mbps down and 0.5 Mbps up. Logistics and drone sync first, visitors capped at 10 percent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="570" width="300" height="100" as="geometry"/></mxCell><mxCell id="0330" value="Firewall policy, permanent rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD344C;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1500" y="110" width="300" height="448" as="geometry"/></mxCell><mxCell id="0331" value="&lt;table style='font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Source&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Destination&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Port&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Action&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Logistics&lt;/td&gt;&lt;td&gt;Cloud API&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Local servers&lt;/td&gt;&lt;td&gt;Cloud API&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Transport&lt;/td&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Management&lt;/td&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Support&lt;/td&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitors&lt;/td&gt;&lt;td&gt;Internet&lt;/td&gt;&lt;td&gt;80, 443&lt;/td&gt;&lt;td&gt;Allow&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Visitors&lt;/td&gt;&lt;td&gt;10.X.0.0/16&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Deny&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Deny&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1510" y="142" width="280" height="340" as="geometry"/></mxCell><mxCell id="0332" value="These rules stay for the whole pilot. The same set repeats at each center." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1516" y="490" width="268" height="50" as="geometry"/></mxCell><mxCell id="0333" value="Cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="920" height="170" as="geometry"/></mxCell><mxCell id="vgw" value="Virtual private&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="1"><mxGeometry x="1385" y="756" width="52" height="52" as="geometry"/></mxCell><mxCell id="box-C04" value="C04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1444" y="756" width="42" height="22" as="geometry"/></mxCell><mxCell id="eps" value="Private endpoints&lt;br&gt;API and S3" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1240" y="756" width="52" height="52" as="geometry"/></mxCell><mxCell id="0334" value="VPC: production 10.70.0.0/16, test 10.60.0.0/16, development 10.50.0.0/16. No overlap with 10.41 to 10.43, and 10.44 to 10.49 stay reserved for future centers." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920" y="756" width="280" height="100" as="geometry"/></mxCell><mxCell id="0335" value="&lt;b&gt;Drone objects.&lt;/b&gt; The ground station uploads at the center through the logistics zone, or at the municipal seat over LTE, with a presigned URL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="750" width="300" height="100" as="geometry"/></mxCell><mxCell id="0339" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="500" height="118" as="geometry"/></mxCell><mxCell id="0341" value="Telemetry" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="748" width="426" height="20" as="geometry"/></mxCell><mxCell id="0343" value="Events and queries" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="770" width="426" height="20" as="geometry"/></mxCell><mxCell id="0345" value="Center and drone traffic" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="792" width="426" height="20" as="geometry"/></mxCell><mxCell id="0347" value="Local network" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="814" width="426" height="20" as="geometry"/></mxCell><mxCell id="0348" value="&lt;b&gt;Mobile network.&lt;/b&gt; Nodes, gateways and phones use LTE, which depends on no network generation being retired during the pilot. Coverage per site needs a survey before installation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="830" height="60" as="geometry"/></mxCell><mxCell id="0314" value="MQTT TLS, LTE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;e