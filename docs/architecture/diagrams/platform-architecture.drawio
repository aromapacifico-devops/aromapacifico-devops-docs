source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2020" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2021" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2027" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="878" as="sourcePoint"/><mxPoint x="1218" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="2029" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1172" y="900" as="sourcePoint"/><mxPoint x="1218" y="900" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="21 Flight object transport"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="860" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="211" value="Where each flight object lives, and which events carry it from the ground station to a published flight record" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1920" height="34" as="geometry"/></mxCell><mxCell id="212" value="&lt;b&gt;Written once, counted once.&lt;/b&gt; Every mission object lands at its final key with a conditional write. Verification and publication run from events and conditional writes, so a repeated upload, event or completion request changes nothing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#AEB6BF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1920" height="40" as="geometry"/></mxCell><mxCell id="213" value="A. Field and upload point" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="300" height="610" as="geometry"/></mxCell><mxCell id="gs" value="&lt;b&gt;Ground station&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Journal keeps each file until the receipt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="260" height="70" as="geometry"/></mxCell><mxCell id="214" value="" style="sketch=0;html=1;shape=mxgraph.networks.pc;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="57" y="319" width="32" height="32" as="geometry"/></mxCell><mxCell id="215" value="Uploads at a municipal seat over the public endpoint, or at a center through the tunnel and the S3 interface endpoint." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEB6BF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="260" height="80" as="geometry"/></mxCell><mxCell id="216" value="B. Platform API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="320" height="610" as="geometry"/></mxCell><mxCell id="up" value="&lt;b&gt;Upload function&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Stores the intent, signs one URL per missing object&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="260" height="70" as="geometry"/></mxCell><mxCell id="217" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="397" y="199" width="32" height="32" as="geometry"/></mxCell><mxCell id="comp" value="&lt;b&gt;Completion function&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Signed manifest, completion rule&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="390" y="470" width="260" height="70" as="geometry"/></mxCell><mxCell id="218" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeC