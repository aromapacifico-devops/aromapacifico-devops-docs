th="32" height="32" as="geometry"/></mxCell><mxCell id="1017" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1299" y="130" width="2" height="1140" as="geometry"/></mxCell><mxCell id="1018" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Encrypted, versioned objects&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1205" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="1019" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1212" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="1020" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1529" y="130" width="2" height="1140" as="geometry"/></mxCell><mxCell id="1021" value="&lt;b&gt;Case table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;DynamoDB, records and keys&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1435" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="1022" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1442" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="1023" value="Preload at the municipal seat or collection center, online" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF2F8;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="146" width="560" height="24" as="geometry"/></mxCell><mxCell id="1024" value="At the lot, no signal needed" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#FEF9E7;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="560" height="24" as="geometry"/></mxCell><mxCell id="1025" value="Synchronization on return, municipal seat or collection center" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF6EC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="844" width="560" height="24" as="geometry"/></mxCell><mxCell id="1032" value="&lt;b&gt;Check and store.&lt;/b&gt; Signature with the pinned public key, every SHA-256, then one atomic move into the mission store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="378" width="400" height="44" as="geometry"/></mxCell><mxCell id="1036" value="&lt;b&gt;Preflight.&lt;/b&gt; Inside the window, highest revision, not suspended, same polygon and exclusion versions, free storage, and for a fumigation a human authorization for this revision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="596" width="400" height="58" as="geometry"/></mxCell><mxCell id="1037" value="&lt;b&gt;Flight.&lt;/b&gt; The drone flies the loaded mission and writes its log, photos and evidence to its own storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="664" width="400" height="40" as="geometry"/></mxCell><mxCell id="1039" value="&lt;b&gt;Journal.&lt;/b&gt; Each file copied, hashed and journaled. The drone copy stays until the station copy matches" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="744" width="400" height="44" as="geometry"/></mxCell><mxCell id="1046" value="&lt;b&gt;Station identity.&lt;/b&gt; Signature checked against the station certificate in the IoT registry. A revoked station cannot publish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="860" y="1042" width="400" height="44" as="geometry"/></mxCell><mxCell id="1051" value="&lt;b&gt;Delete.&lt;/b&gt; The station deletes its copy only after the receipt. A repeated request returns the same receipt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="1226" width="400" height="36" as="geometry"/></mxCell><mxCell id="1052" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="560" height="140" as="geometry"/></mxCell><mxCell id="1054" value="Mission, acknowledgement and record" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1314" width="486" height="20" as="geometry"/></mxCell><mxCell id="1056" value="Package files and flight evidence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1336" width="486" height="20" as="geometry"/></mxCell><mxCell id="1058" value="Signing and verification" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1358" width="486" height="20" as="geometry"/></mxCell><mxCell id="1060" value="Failure, data stays local" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1380" width="486" height="20" as="geometry"/></mxCell><mxCell id="1062" value="Dashed line, an answer to a request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1402" width="486" height="20" as="geometry"/></mxCell><mxCell id="1063" value="&lt;b&gt;Fumigation.&lt;/b&gt; A fumigation package exists only after the prerequisite flight is published and a supervisor, distinct from the pilot, authorizes it. Inference never authorizes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="1286" width="1040" height="50" as="geometry"/></mxCell><mxCell id="1064" value="&lt;b&gt;Large files.&lt;/b&gt; Above 100 MB the station uses a multipart upload with a full-object CRC checksum, keeps its upload ID, and resends only missing parts. Verification then computes the SHA-256." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="1350" width="1040" height="50" as="geometry"/></mxCell><mxCell id="1026" value="Sign in, Cognito with second factor" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="190" as="sourcePoint"/><mxPoint x="820" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1027" value="Sign manifest digest" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="224" as="sourcePoint"/><mxPoint x="1060" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1028" value="ECDSA signature" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="258" as="sourcePoint"/><mxPoint x="820" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1029" value="Signed manifest, download links" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="292" as="sourcePoint"/><mxPoint x="520" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1030" value="Download package files" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="326" as="sourcePoint"/><mxPoint x="1300" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1031" value="Polygon, exclusions, route" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="360" as="sourcePoint"/><mxPoint x="520" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1033" value="Station acknowledgement, package digest" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="444" as="sourcePoint"/><mxPoint x="820" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1034" value="Load mission, local link" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="478" as="sourcePoint"/><mxPoint x="230" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1035" value="Loaded digest read back" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="512" as="sourcePoint"/><mxPoint x="520" y="512" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1038" value="Log and evidence, file by file" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="726" as="sourcePoint"/><mxPoint x="520" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1040" value="No path, upload waits" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="804" as="sourcePoint"/><mxPoint x="780" y="804" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1041" value="Sign in again, object list with sizes and SHA-256" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="888" as="sourcePoint"/><mxPoint x="820" y="888" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1042" value="Missing objects, fresh presigned URLs" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="922" as="sourcePoint"/><mxPoint x="520" y="922" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1043" value="PUT with SHA-256 checksum, one URL per object" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="956" as="sourcePoint"/><mxPoint x="1300" y="956" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1044" value="Version ID, or rejected and retried" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="990" as="sourcePoint"/><mxPoint x="520" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1045" value="Completion, manifest signed by the station key" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1024" as="sourcePoint"/><mxPoint x="820" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1047" value="Read checksum and version" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1108" as="sourcePoint"/><mxPoint x="1300" y="1108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1048" value="Stored checksum, version ID" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1142" as="sourcePoint"/><mxPoint x="820" y="1142" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1049" value="Conditional write, flight record" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1176" as="sourcePoint"/><mxPoint x="1530" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1050" value="Publication receipt" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1210" as="sourcePoint"/><mxPoint x="520" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1053" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1324" as="sourcePoint"/><mxPoint x="98" y="1324" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1055" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1346" as="sourcePoint"/><mxPoint x="98" y="1346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1057" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1368" as="sourcePoint"/><mxPoint x="98" y="1368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1059" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1390" as="sourcePoint"/><mxPoint x="98" y="1390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1061" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1412" as="sourcePoint"/><mxPoint x="98" y="1412" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="11 Audit evidence path"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="990" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="111" value="How evidence of the four sensitive events reaches a store that no account can alter" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1780" height="34" as="geometry"/></mxCell><mxCell id="112" value="People and devices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;