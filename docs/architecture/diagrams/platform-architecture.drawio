"1780" pageHeight="760" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="121" value="Lot polygon states: from no-fly zones to a published version that missions can use" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1700" height="34" as="geometry"/></mxCell><mxCell id="122" value="Before the first flight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="560" height="380" as="geometry"/></mxCell><mxCell id="123" value="Delimitation flight and review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="615" y="70" width="565" height="380" as="geometry"/></mxCell><mxCell id="124" value="In use by missions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1195" y="70" width="545" height="380" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;DRAFT&lt;/b&gt;&lt;br&gt;Zones or polygon&lt;br&gt;in preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="excl" value="&lt;b&gt;EXCLUSIONS_READY&lt;/b&gt;&lt;br&gt;Only the delimitation flight&lt;br&gt;&lt;i&gt;lot.exclusions.ready&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="surv" value="&lt;b&gt;SURVEYED&lt;/b&gt;&lt;br&gt;Candidate polygon&lt;br&gt;from the flight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;VALIDATED&lt;/b&gt;&lt;br&gt;Polygon and no-spray&lt;br&gt;strips accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="pub" value="&lt;b&gt;PUBLISHED&lt;/b&gt;&lt;br&gt;Precision and estimation&lt;br&gt;&lt;i&gt;lot.geometry.published&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="susp" value="&lt;b&gt;SUSPENDED&lt;/b&gt;&lt;br&gt;No new mission&lt;br&gt;&lt;i&gt;lot.geometry.suspended&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1520" y="130" width="180" height="84" as="geometry"/></mxCell><mxCell id="1213" value="Correction or failed check returns the candidate to draft" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="260" y="256" width="380" height="20" as="geometry"/></mxCell><mxCell id="1215" value="A replacement starts as a new draft, and the published version stays in use until it is replaced" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1565C0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="336" width="620" height="20" as="geometry"/></mxCell><mxCell id="1216" value="&lt;b&gt;Supervisor.&lt;/b&gt; Maps houses, the processing facility, roads and water as no-fly zones, or records that there are none." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="372" width="520" height="60" as="geometry"/></mxCell><mxCell id="1217" value="&lt;b&gt;Checks.&lt;/b&gt; Flight log and map stored, valid GeoJSON, ring direction, no self-intersection, strips computed in metres in EPSG 9377." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="635" y="372" width="525" height="60" as="geometry"/></mxCell><mxCell id="1218" value="&lt;b&gt;Missions.&lt;/b&gt; Each package carries this exact version. A fumigation also needs a closed prior log and a named supervisor." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1215" y="372" width="505" height="60" as="geometry"/></mxCell><mxCell id="1219" value="No-spray strips for the drone, stored as versioned parameters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="1160" height="250" as="geometry"/></mxCell><mxCell id="1220" value="&lt;table style='font-size:12px' cellpadding='4'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Place&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Drone&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Ground&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Basis&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rivers, streams, lakes&lt;/td&gt;&lt;td&gt;100 m&lt;/td&gt;&lt;td&gt;10 m&lt;/td&gt;&lt;td&gt;Decree 1843 of 1991, article 87&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Springs&lt;/td&gt;&lt;td&gt;100 m&lt;/td&gt;&lt;td&gt;100 m&lt;/td&gt;&lt;td&gt;Decree 1076 of 2015, protective forest area&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Houses and processing facility&lt;/td&gt;&lt;td&gt;100 m&lt;/td&gt;&lt;td&gt;10 m&lt;/td&gt;&lt;td&gt;Decree 1843, articles 87 and 102&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Main roads&lt;/td&gt;&lt;td&gt;100 m&lt;/td&gt;&lt;td&gt;10 m&lt;/td&gt;&lt;td&gt;Decree 1843, article 87&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;People outside the operation&lt;/td&gt;&lt;td&gt;30 m, no flight&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;RAC 100, sections 100.310 and 100.410&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="514" width="700" height="200" as="geometry"/></mxCell><mxCell id="1221" value="&lt;b&gt;Ground fallback.&lt;/b&gt; A focus inside the drone strip and outside the ground strip becomes a ground application by the brigade, with the same authorization. Inside the ground strip no product is applied." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="520" width="400" height="100" as="geometry"/></mxCell><mxCell id="1222" value="&lt;b&gt;Pending.&lt;/b&gt; Strips for minor roads and narrower water strips with barriers wait for a legal review." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1320" y="634" width="400" height="70" as="geometry"/></mxCell><mxCell id="1223" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="520" height="96" as="geometry"/></mxCell><mxCell id="1225" value="Normal path, conditional write" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="508" width="446" height="20" as="geometry"/></mxCell><mxCell id="1227" value="Correction, failure or suspension" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="530" width="446" height="20" as="geometry"/></mxCell><mxCell id="1229" value="Replacement by a new version" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="552" width="446" height="20" as="geometry"/></mxCell><mxCell id="1230" value="No state can be skipped, and a published version is never edited." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="520" height="44" as="geometry"/></mxCell><mxCell id="125" value="zones reviewed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="draft" target="excl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="126" value="log stored" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="excl" target="surv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="127" value="checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="surv" target="val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="128" value="published" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="val" target="pub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="129" value="safety reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="pub" target="susp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1210" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="excl" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="254"/><mxPoint x="205" y="254"/></Array></mxGeometry></mxCell><mxCell id="1211" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="surv" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="279"/><mxPoint x="160" y="279"/></Array></mxGeometry></mxCell><mxCell id="1212" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="val" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="304"/><mxPoint x="115" y="304"/></Array></mxGeometry></mxCell><mxCell id="1214" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.11;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="susp" target="draft"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1610" y="334"/><mxPoint x="90" y="334"/></Array></mxGeometry></mxCell><mxCell id="1224" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="518" as="sourcePoint"/><mxPoint x="98" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1226" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="540" as="sourcePoint"/><mxPoint x="98" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="1228" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="562" as="sourcePoint"/><mxPoint x="98" y="562" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="13 Center operation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="131" value="How a collection center receives, labels and dispatches sacks, and what limits it at 400 sacks a day" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1620" height="34" as="geometry"/></mxCell><mxCell id="132" value="Reception: arrival is one action for the load, the decision is one event for each sack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1640" height="250" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;1. Load arrives&lt;/b&gt;&lt;br&gt;carrier, once&lt;br&gt;arrived_at_center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. Waiting area&lt;/b&gt;&lt;br&gt;sacks stay in transit&lt;br&gt;no event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. Scan the label&lt;/b&gt;&lt;br&gt;15 s, assumed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;4. Weigh&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;farm weight is kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;5. Inspect&lt;/b&gt;&lt;br&gt;90 s, assumed&lt;br&gt;no criteria invented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;6. Decide and record&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;reception weight, reason code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;7. Move the sack&lt;/b&gt;&lt;br&gt;20 s, assumed&lt;br&gt;stack or return area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1430" y="110" width="190" height="80" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Accepted&lt;/b&gt;&lt;br&gt;received_accepted&lt;br&gt;then dispatched_to_port, groups of 30, 15 s a sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="300" height="70" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;received_rejected&lt;br&gt;then returned_to_farm, same code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="215" width="250" height="70" as="geometry"/></mxCell><mxCell id="1311" value="The five reception steps add up to 165 s for each sack. The dispatch scan of 15 s makes 180 s and belongs to the dispatch station." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="480" height="70" as="geometry"/></mxCell><mxCell id="1312" value="A correction before dispatch is an event with a reason code and an observation. The codes stay provisional until the Federation confirms its criteria." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="560" y="215" width="450" height="70" as="geometry"/></mxCell><mxCell id="1313" value="Sack that arrives with no code: four steps, each one can fail alone and none creates a second sack or code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565C0;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="1640" height="270" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;A. Assign a code&lt;/b&gt;&lt;br&gt;from the issued block of this device&lt;br&gt;20 s with B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;B. Register&lt;/b&gt;&lt;br&gt;registered_at_center&lt;br&gt;farm, weight, event_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;C. Print one label&lt;/b&gt;&lt;br&gt;30 s on the printer&lt;br&gt;never two identical labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#1565C0;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;D. Attach and scan&lt;/b&gt;&lt;br&gt;40 s&lt;br&gt;scan must match the registered code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="rcv" value="&lt;b&gt;Reception&lt;/b&gt;&lt;br&gt;steps 3 to 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1300" y="390" width="150" height="80" as="geometry"/></mxCell><mxCell id="1318" value="&lt;b&gt;If it fails.&lt;/b&gt; No code left in the block. Stop, use another device or wait. No code is invented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1319" value="&lt;b&gt;If it fails.&lt;/b&gt; Event waits on the device and repeats with the same event_id. A second registration of the code is an anomaly." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1320" value="&lt;b&gt;If it fails.&lt;/b&gt; No label came out. Print again for the same code, a retry that makes no sack, no code and no reprint record." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1321" value="&lt;b&gt;If it fails.&lt;/b&gt; Mismatch. Stop the sack, void the label and print again as a reprint with the same code." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="490" width="250" height="100" as="geometry"/></mxCell><mxCell id="1322" value="&lt;b&gt;Printing rule pending.&lt;/b&gt; Address, protocol and port of the printer are not confirmed, so no permission is opened. A receipt, if any, is a separate non-adhesive slip with no QR." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1300" y="490" width="350" height="100" as="geometry"/></mxCell><mxCell id="1323" value="Work with no internet and reprints" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E65100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="810" height="330" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Reserve of the center&lt;/b&gt;&lt;br&gt;10 percent of 400 sacks for 2 days = 80 codes, assumed&lt;br&gt;sized first, issued in advance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="300" height="80" as="geometry"/></mxCell><mxCell id="blk" value="&lt;b&gt;Exclusive blocks&lt;/b&gt;&lt;br&gt;no overlap, one per device&lt;br&gt;40 + 40, or 27 + 27 + 26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="250" height="80" as="geometry"/></mxCell><mxCell id="1325" value="&lt;b&gt;Exhausted.&lt;/b&gt; Stop. &lt;b&gt;Lost device.&lt;/b&gt; Freeze its codes and never reuse them. &lt;b&gt;Link back.&lt;/b&gt; Events arrive, gaps close, a new block is issued, and the 48 h review list fills." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="600" height="70" as="geometry"/></mxCell><mxCell id="1326" value="&lt;b&gt;Reprint.&lt;/b&gt; Same code, reason code, label_reprinted, old label withdrawn or voided when possible. Review from the third reprint is an operating assumption." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="885" width="600" height="70" as="geometry"/></mxCell><mxCell id="1327" value="Capacity at 400 sacks a day, with assumed times to measure in the first harvest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="870" y="640" width="800" height="370" as="geometry"/></mxCell><mxCell id="cap" value="&lt;b&gt;Busiest hour&lt;/b&gt;&lt;br&gt;150 sacks, 3 times the average of 50&lt;br&gt;9 people cover the hour at 85 percent, in the model&lt;br&gt;4 people complete the day, 63 sacks queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="690" width="360" height="90" as="geometry"/></mxCell><mxCell id="bot" value="&lt;b&gt;Bottleneck: inspection&lt;/b&gt;&lt;br&gt;48 percent of the person time of a sack&lt;br&gt;5 people inspecting in the busiest hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1280" y="690" width="370" height="90" as="geometry"/></mxCell><mxCell id="1328" value="&lt;b&gt;People set the pace.&lt;/b&gt; 2 desktops and 20 phones say nothing about people, scales or inspection pace. With 4 people the backlog is 63 sacks after the busiest hour." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="800" width="360" height="80" as="geometry"/></mxCell><mxCell id="1329" value="&lt;b&gt;One scale&lt;/b&gt; runs at 83 percent in the busiest hour. &lt;b&gt;One printer&lt;/b&gt; is busy 19 percent with 10 percent of sacks with no code and 5 percent reprints." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1280" y="800" width="370" height="80" as="geometry"/></mxCell><mxCell id="1330" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="890" y="895" width="360" height="96" as="geometry"/></mxCell><mxCell id="1332" value="Normal path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="923" width="286" height="20" as="geometry"/></mxCell><mxCell id="1334" value="Rejection or failure" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="945" width="286" height="20" as="geometry"/></mxCell><mxCell id="1336" value="Step that depends on the pending printing rule" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="956" y="967" width="286" height="20" as="geometry"/></mxCell><mxCell id="133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10