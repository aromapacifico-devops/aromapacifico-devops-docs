or=#F4F6F7;strokeColor=#AEB6BF;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1780" height="130" as="geometry"/></mxCell><mxCell id="043" value="Inference functions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#AEB6BF;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1780" height="130" as="geometry"/></mxCell><mxCell id="044" value="Human decision, MFA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#AEB6BF;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1780" height="130" as="geometry"/></mxCell><mxCell id="045" value="Drone brigade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#AEB6BF;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1780" height="130" as="geometry"/></mxCell><mxCell id="a1" value="Lot polygon and&lt;br&gt;no-fly zones published" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="200" y="124" width="150" height="62" as="geometry"/></mxCell><mxCell id="a2" value="Reading out of range&lt;br&gt;raises an alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="370" y="124" width="150" height="62" as="geometry"/></mxCell><mxCell id="a3" value="Confirmation&lt;br&gt;mission issued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="540" y="124" width="150" height="62" as="geometry"/></mxCell><mxCell id="a4" value="Focus confirmed,&lt;br&gt;case open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1020" y="124" width="150" height="62" as="geometry"/></mxCell><mxCell id="a5" value="Fumigation order: farm, lot,&lt;br&gt;reason, window, operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1190" y="124" width="170" height="62" as="geometry"/></mxCell><mxCell id="a6" value="Log stored,&lt;br&gt;awaiting verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1420" y="124" width="150" height="62" as="geometry"/></mxCell><mxCell id="a7" value="Case closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1640" y="124" width="130" height="62" as="geometry"/></mxCell><mxCell id="f1" value="Person filter, then&lt;br&gt;Bedrock on the focus object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="264" width="190" height="62" as="geometry"/></mxCell><mxCell id="f2" value="Verification object&lt;br&gt;can close the case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1620" y="264" width="170" height="62" as="geometry"/></mxCell><mxCell id="h1" value="Supervisor authorizes&lt;br&gt;the order, named person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1190" y="404" width="170" height="62" as="geometry"/></mxCell><mxCell id="d1" value="Flies to the focus,&lt;br&gt;uploads object and log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="540" y="544" width="170" height="62" as="geometry"/></mxCell><mxCell id="d2" value="Fumigates in the window,&lt;br&gt;records product lot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1190" y="544" width="170" height="62" as="geometry"/></mxCell><mxCell id="d3" value="Closes the fumigation&lt;br&gt;flight log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1420" y="544" width="150" height="62" as="geometry"/></mxCell><mxCell id="d4" value="Verification photo&lt;br&gt;or short path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1640" y="544" width="150" height="62" as="geometry"/></mxCell><mxCell id="0419" value="Failure and stop conditions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="880" height="230" as="geometry"/></mxCell><mxCell id="0420" value="&lt;b&gt;Person in the object.&lt;/b&gt; The object moves to a restricted prefix, never reaches inference, and the operator repeats the capture." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="684" width="410" height="84" as="geometry"/></mxCell><mxCell id="0421" value="&lt;b&gt;Inference fails.&lt;/b&gt; The object stays, the state does not change. Three retries, then the dead letter queue and an alarm." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="684" width="410" height="84" as="geometry"/></mxCell><mxCell id="0422" value="&lt;b&gt;No polygon or no closed log.&lt;/b&gt; The order does not go out." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="410" height="84" as="geometry"/></mxCell><mxCell id="0423" value="&lt;b&gt;Verification object missing.&lt;/b&gt; The fumigation stays open, and the dashboard reports it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="410" height="84" as="geometry"/></mxCell><mxCell id="0424" value="The four event triggers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#01A88D;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="940" y="650" width="880" height="230" as="geometry"/></mxCell><mxCell id="0425" value="&lt;table style='font-size:12px' cellpadding='4'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Trigger&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Function persists&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Never does&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Focus confirmation object &lt;b&gt;(C08)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Whether the focus is confirmed&lt;/td&gt;&lt;td&gt;Authorize fumigation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Verification object&lt;/td&gt;&lt;td&gt;Whether the case can close&lt;/td&gt;&lt;td&gt;Change state if the object is missing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Estimation flight object&lt;/td&gt;&lt;td&gt;Estimated sacks for the center&lt;/td&gt;&lt;td&gt;Create a packing order&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Telemetry batch&lt;/td&gt;&lt;td&gt;Reading out of threshold&lt;/td&gt;&lt;td&gt;Fix thresholds in code&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Each result stores time, confidence and source object in the same case file." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="960" y="684" width="840" height="190" as="geometry"/></mxCell><mxCell id="0426" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="896" width="880" height="74" as="geometry"/></mxCell><mxCell id="0428" value="State and order flow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="924" width="806" height="20" as="geometry"/></mxCell><mxCell id="0430" value="Object and result flow" style="te