rive&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="910" y="788" width="140" height="46" as="geometry"/></mxCell><mxCell id="1934" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="917" y="795" width="32" height="32" as="geometry"/></mxCell><mxCell id="1937" value="C. Managed call and stored result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="980" height="840" as="geometry"/></mxCell><mxCell id="1938" value="Function" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E86C1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="158" width="180" height="20" as="geometry"/></mxCell><mxCell id="1939" value="Managed call" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E86C1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="158" width="220" height="20" as="geometry"/></mxCell><mxCell id="1940" value="Stored result" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E86C1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1720" y="158" width="230" height="20" as="geometry"/></mxCell><mxCell id="1941" value="Business handoff" style="text;html=1;whiteSpace=wrap;strokeColor=none;fill