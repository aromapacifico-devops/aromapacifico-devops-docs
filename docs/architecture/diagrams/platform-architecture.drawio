Align=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1020" y="1474" width="180" height="66" as="geometry"/></mxCell><mxCell id="00130" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#616161;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="1027" y="1491" width="32" height="32" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Output kept as evidence&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1220" y="1474" width="160" height="66" as="geometry"/></mxCell><mxCell id="00131" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#616161;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="1227" y="1491" width="32" height="32" as="geometry"/></mxCell><mxCell id="00132" value="C09" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1346" y="1468" width="32" height="17" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Person approves&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Protected environment&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontS