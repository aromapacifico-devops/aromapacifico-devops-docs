=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="1480" height="276" as="geometry"/></mxCell><mxCell id="074" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="1480" height="288" as="geometry"/></mxCell><mxCell id="075" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="249" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="076" value="&lt;b&gt;Farm node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Controller, flash buffer, LTE modem&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="155" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="077" value="" style="sketch=0;html=1;shape=mxgraph.networks.wireless_modem;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="162" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="078" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="609" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="079" value="&lt;b&gt;Mobile network&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Attach and network time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="515" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0710" value="" style="sketch=0;html=1;shape=mxgraph.networks.radio_tower;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="522" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0711" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="859" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0712" value="&lt;b&gt;AWS IoT Core&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Broker, rule and shadow&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="765" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0713" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1"><mxGeometry x="772" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0714" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1119" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0715" value="&lt;b&gt;Queue and function&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;SQS, ingestion function&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1025" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0716" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1032" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0717" value="" style="rounded=0;html=1;fillColor=#AAB7B8;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1389" y="130" width="2" height="970" as="geometry"/></mxCell><mxCell id="0718" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Readings and alert state&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;strokeWidth=1.2;dashed=0;align=left;verticalAlign=middle;spacingLeft=44;spacingRight=3;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1295" y="70" width="190" height="60" as="geometry"/></mxCell><mxCell id="0719" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1302" y="84" width="32" height="32" as="geometry"/></mxCell><mxCell id="0720" value="Connection, each hour at the minute fixed for the node" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF6EC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="146" width="470" height="24" as="geometry"/></mxCell><mxCell id="0721" value="Disconnection, a failure at any step ends the same way" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#FDEDEC;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="470" height="24" as="geometry"/></mxCell><mxCell id="0722" value="Recovery, the signal returns" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#232F3E;fillColor=#EAF2F8;strokeColor=none;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="50" y="818" width="470" height="24" as="geometry"/></mxCell><mxCell id="0723" value="&lt;b&gt;Wake.&lt;/b&gt; Read if due, append record with seq and measured_at, delete records of 24 h or more" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="176" width="360" height="44" as="geometry"/></mxCell><mxCell id="0735" value="&lt;b&gt;No path.&lt;/b&gt; Records stay. The next hour is the retry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="360" height="34" as="geometry"/></mxCell><mxCell id="0740" value="&lt;b&gt;No PUBACK in 10 s.&lt;/b&gt; Record stays, modem off, sleep until the next hour" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="360" height="34" as="geometry"/></mxCell><mxCell id="0741" value="&lt;b&gt;At 24 h.&lt;/b&gt; A record still waiting is deleted, and dropped_total grows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="746" width="360" height="34" as="geometry"/></mxCell><mxCell id="0751" value="&lt;b&gt;Alerts.&lt;/b&gt; Only a newer measured_at changes the alert state. An alert from an old reading carries the time of that reading" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="960" y="1020" width="540" height="44" as="geometry"/></mxCell><mxCell id="0753" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="560" height="140" as="geometry"/></mxCell><mxCell id="0755" value="Reading and its confirmation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1144" width="486" height="20" as="geometry"/></mxCell><mxCell id="0757" value="Configuration through the shadow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1166" width="486" height="20" as="geometry"/></mxCell><mxCell id="0759" value="Connection control" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1188" width="486" height="20" as="geometry"/></mxCell><mxCell id="0761" value="Failure or rejection" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1210" width="486" height="20" as="geometry"/></mxCell><mxCell id="0763" value="Dashed line, an answer to a request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="1232" width="486" height="20" as="geometry"/></mxCell><mxCell id="0724" value="Attach, network time" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="240" as="sourcePoint"/><mxPoint x="610" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0725" value="TLS, CONNECT clean session" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="274" as="sourcePoint"/><mxPoint x="860" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0726" value="CONNACK" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="308" as="sourcePoint"/><mxPoint x="250" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0727" value="PUBLISH QoS 1, oldest first, 10 unconfirmed at most" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="342" as="sourcePoint"/><mxPoint x="860" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0728" value="Rule adds received_at" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="342" as="sourcePoint"/><mxPoint x="1120" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0729" value="Conditional write" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="342" as="sourcePoint"/><mxPoint x="1390" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0730" value="PUBACK, record leaves the buffer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="376" as="sourcePoint"/><mxPoint x="250" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0731" value="Get shadow" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="410" as="sourcePoint"/><mxPoint x="860" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0732" value="Desired state, drying on or off" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="444" as="sourcePoint"/><mxPoint x="250" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0733" value="DISCONNECT, then modem off and sleep" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="478" as="sourcePoint"/><mxPoint x="860" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0734" value="Attach fails, window of 120 s ends" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="572" as="sourcePoint"/><mxPoint x="610" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0736" value="PUBLISH seq n" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="640" as="sourcePoint"/><mxPoint x="860" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0737" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="640" as="sourcePoint"/><mxPoint x="1120" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0738" value="Stored" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="640" as="sourcePoint"/><mxPoint x="1390" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0739" value="PUBACK lost" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="674" as="sourcePoint"/><mxPoint x="540" y="674" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0742" value="Attach, signal is back" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="850" as="sourcePoint"/><mxPoint x="610" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0743" value="PUBLISH seq n, repeat, buffered true" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="886" as="sourcePoint"/><mxPoint x="860" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0744" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="886" as="sourcePoint"/><mxPoint x="1120" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0745" value="Conditional write" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="886" as="sourcePoint"/><mxPoint x="1390" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0746" value="Rejected, already stored" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="920" as="sourcePoint"/><mxPoint x="1120" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0747" value="PUBACK, record leaves the buffer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="954" as="sourcePoint"/><mxPoint x="250" y="954" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0748" value="PUBLISH seq n+1 and newer, buffered true" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="988" as="sourcePoint"/><mxPoint x="860" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0749" value="Copy to queue" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="988" as="sourcePoint"/><mxPoint x="1120" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0750" value="Stored, state if newer" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="988" as="sourcePoint"/><mxPoint x="1390" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0752" value="Get shadow, DISCONNECT, sleep" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="1064" as="sourcePoint"/><mxPoint x="860" y="1064" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0754" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1154" as="sourcePoint"/><mxPoint x="98" y="1154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0756" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#6A1B9A;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1176" as="sourcePoint"/><mxPoint x="98" y="1176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0758" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1198" as="sourcePoint"/><mxPoint x="98" y="1198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0760" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1220" as="sourcePoint"/><mxPoint x="98" y="1220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0762" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="1242" as="sourcePoint"/><mxPoint x="98" y="1242" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="08 Sack state model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="830" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="081" value="Sack states and transitions: from the farm to the port, and what a rejection does" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1480" height="34" as="geometry"/></mxCell><mxCell id="082" value="Farm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="480" as="geometry"/></mxCell><mxCell id="083" value="Road to the center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="280" height="480" as="geometry"/></mxCell><mxCell id="084" value="Collection center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="310" height="480" as="geometry"/></mxCell><mxCell id="085" value="Road to the port" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="280" height="480" as="geometry"/></mxCell><mxCell id="086" value="Port of Buenaventura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#E65100;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="310" height="480" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;in_preparation&lt;/b&gt;&lt;br&gt;Farmer holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="190" height="70" as="geometry"/></mxCell><mxCell id="toc" value="&lt;b&gt;in_transit_to_center&lt;/b&gt;&lt;br&gt;Carrier holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="385" y="280" width="190" height="70" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;at_center_accepted&lt;/b&gt;&lt;br&gt;Center holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;at_center_rejected&lt;/b&gt;&lt;br&gt;Resting state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="190" height="70" as="geometry"/></mxCell><mxCell id="top" value="&lt;b&gt;in_transit_to_port&lt;/b&gt;&lt;br&gt;Carrier holds the sack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="985" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;delivered_accepted&lt;/b&gt;&lt;br&gt;End of the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1285" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="no" value="&lt;b&gt;delivered_rejected&lt;/b&gt;&lt;br&gt;End of the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C62828;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1285" y="240" width="190" height="70" as="geometry"/></mxCell><mxCell id="s1" value="Start at the farm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="52" y="120" width="105" height="56" as="geometry"/></mxCell><mxCell id="s2" value="Start at the center, no code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="175" y="120" width="115" height="56" as="geometry"/></mxCell><mxCell id="0816" value="Correct to rejected, with reason" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="84" height="60" as="geometry"/></mxCell><mxCell id="0817" value="Correct to accepted, with reason" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="792" y="290" width="100" height="60" as="geometry"/></mxCell><mxCell id="0820" value="delivered_accepted" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1090" y="150" width="130" height="22" as="geometry"/></mxCell><mxCell id="0822" value="delivered_rejected" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1090" y="250" width="130" height="22" as="geometry"/></mxCell><mxCell id="0824" value="&lt;b&gt;The history keeps every event.&lt;/b&gt; Arrival, pickup, reweighing, label reprint and a missing report change no state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1225" y="400" width="280" height="66" as="geometry"/></mxCell><mxCell id="0825" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="560" height="118" as="geometry"/></mxCell><mxCell id="0827" value="Normal path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="594" width="486" height="20" as="geometry"/></mxCell><mxCell id="0829" value="Rejection and return" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="616" width="486" height="20" as="geometry"/></mxCell><mxCell id="0831" value="Correction, before the sack leaves the center" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="638" width="486" height="20" as="geometry"/></mxCell><mxCell id="0833" value="Only a sack registered at the center" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="660" width="486" height="20" as="geometry"/></mxCell><mxCell id="0834" value="&lt;b&gt;Applied.&lt;/b&gt; The event fits the history, and the state moves." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0835" value="&lt;b&gt;Gap.&lt;/b&gt; An earlier event is missing. The state moves, and the late event closes the gap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0836" value="&lt;b&gt;Anomaly.&lt;/b&gt; The event contradicts the history. It is kept for review, and the state stays." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1220" y="566" width="280" height="66" as="geometry"/></mxCell><mxCell id="0837" value="&lt;b&gt;Order.&lt;/b&gt; The state comes from replaying the history by time of capture, so any arrival order gives the same result." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="620" y="646" width="880" height="44" as="geometry"/></mxCell><mxCell id="087" value="registered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="088" value="registered_at_center" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="089" value="handed_to_carrier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="prep" target="toc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0810" value="received_accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toc" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="301"/><mxPoint x="615" y="205"/></Array></mxGeometry></mxCell><mxCell id="0811" value="received_rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="toc" target="rej"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="329"/><mxPoint x="615" y="435"/></Array></mxGeometry></mxCell><mxCell id="0812" value="reception, sack with no code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prep" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="290"/><mxPoint x="305" y="145"/><mxPoint x="745" y="145"/></Array></mxGeometry></mxCell><mxCell id="0813" value="reception, sack with no code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prep" target="rej"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="340"/><mxPoint x="305" y="490"/><mxPoint x="688" y="490"/></Array></mxGeometry></mxCell><mxCell id="0814" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0815" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rej" target="acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0818" value="dispatched_to_port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="acc" target="top"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="0819" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="top" target="ok"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="191"/><mxPoint x="1235" y="145"/></Array></mxGeometry></mxCell><mxCell id="0821" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="top" target="no"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="219"/><mxPoint x="1235" y="275"/></Array></mxGeometry></mxCell><mxCell id="0823" value="returned_to_farm, same code and same history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rej" target="prep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="520"/><mxPoint x="150" y="520"/></Array></mxGeometry></mxCell><mxCell id="0826" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2E7D32;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="604" as="sourcePoint"/><mxPoint x="98" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0828" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#C62828;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="626" as="sourcePoint"/><mxPoint x="98" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0830" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#616161;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="648" as="sourcePoint"/><mxPoint x="98" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="0832" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="52" y="670" as="sourcePoint"/><mxPoint x="98" y="670" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="09 Center WLAN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="940" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="091" value="How the WLAN of a center is segmented: SSID, VLAN and what each zone may reach" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1620" height="34" as="geometry"/></mxCell><mxCell id="092" value="Wi-Fi clients and their SSID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="640" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Access points&lt;/b&gt;&lt;br&gt;2 to 3, powered by the switch&lt;br&gt;five SSIDs&lt;br&gt;one VLAN per SSID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="150" height="548" as="geometry"/></mxCell><mxCell id="z0" value="&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;AP-GER, VLAN 101&lt;br&gt;10.X.1.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="360" height="92" as="geometry"/></mxCell><mxCell id="z1" value="&lt;b&gt;Support&lt;/b&gt;&lt;br&gt;AP-SOP, VLAN 2&lt;br&gt;10.X.2.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="360" height="92" as="geometry"/></mxCell><mxCell id="z2" value="&lt;b&gt;Logistics&lt;/b&gt;&lt;br&gt;AP-LOG, VLAN 3&lt;br&gt;10.X.3.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="360" height="92" as="geometry"/></mxCell><mxCell id="z3" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;AP-TRA, VLAN 4&lt;br&gt;10.X.4.0/24, WPA3-Personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="360" height="92" as="geometry"/></mxCell><mxCell id="z4" value="&lt;b&gt;Visitors&lt;/b&gt;&lt;br&gt;AP-VIS, VLAN 5&lt;br&gt;10.X.5.0/24, isolated clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="360" height="92" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;Managed switch&lt;/b&gt;&lt;br&gt;trunks carry only the listed VLANs&lt;br&gt;no routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="750" y="339" width="140" height="90" as="geometry"/></mxCell><mxCell id="fw" value="Perimeter firewall&lt;br&gt;gateway of every zone" style="sketch=0;html=1;shape=mxgraph.networks.firewall;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1040" y="358" width="52" height="52" as="geometry"/></mxCell><mxCell id="0910" value="Local servers, VLAN 10, wired only, 10.X.10.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="500" height="270" as="geometry"/></mxCell><mxCell id="prt" value="&lt;b&gt;Label printer&lt;/b&gt;&lt;br&gt;10.X.10.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="swm" value="&lt;b&gt;Switch&lt;/b&gt;&lt;br&gt;10.X.10.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="apm" value="&lt;b&gt;Access points&lt;/b&gt;&lt;br&gt;10.X.10.3 to .5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#147EBA;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b&gt;Administration host&lt;/b&gt;&lt;br&gt;10.X.10.11 to .20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=center;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="0911" value="Each device accepts administration only from the administration host." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1180" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="net" value="Internet" style="sketch=0;html=1;shape=mxgraph.networks.cloud;fillColor=#29AAE1;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1290" y="358" width="80" height="52" as="geometry"/></mxCell><mxCell id="0916" value="Cloud, us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="480" width="500" height="210" as="geometry"/></mxCell><mxCell id="vgw" value="Virtual private&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="1"><mxGeometry x="1260" y="540" width="52" height="52" as="geometry"/></mxCell><mxCell id="eps" value="Private endpoints&lt;br&gt;API and S3" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1500" y="540" width="52" height="52" as="geometry"/></mxCell><mxCell id="0919" value="Four layers keep visitors apart, and each one stops them on its own" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#C62828;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#C62828;" vertex="1" parent="1"><mxGeometry x="460" y="730" width="1200" height="180" as="geometry"/></mxCell><mxCell id="0920" value="&lt;b&gt;1. Access point.&lt;/b&gt; Client isolation on AP-VIS stops one visitor phone from reaching another." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="480" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0921" value="&lt;b&gt;2. VLAN and trunk.&lt;/b&gt; VLAN 5 exists only on the access point trunks and the firewall uplink, with no wired port." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0922" value="&lt;b&gt;3. Firewall.&lt;/b&gt; Deny toward every private range and toward the firewall itself, ahead of the internet allow. Only DHCP and DNS reach the gateway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0923" value="&lt;b&gt;4. Tunnel and cloud.&lt;/b&gt; No route for 10.X.5.0/24, and endpoint security groups accept only logistics and local servers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#DD344C;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1350" y="770" width="270" height="110" as="geometry"/></mxCell><mxCell id="0924" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="400" height="118" as="geometry"/></mxCell><mxCell id="0926" value="Wi-Fi association, named by SSID" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="758" width="326" height="20" as="geometry"/></mxCell><mxCell id="0928" value="Wired trunk or administration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="780" width="326" height="20" as="geometry"/></mxCell><mxCell id="0930" value="Path the firewall allows" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="802" width="326" height="20" as="geometry"/></mxCell><mxCell id="0932" value="Rule defined, not enabled" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="106" y="824" width="326" height="20" as="geometry"/></mxCell><mxCell id="0933" value="&lt;b&gt;X is 41 Cauca, 42 Huila or 43 Tolima.&lt;/b&gt; Only logistics and local servers reach the cloud. No zone reaches another. The printing rule from logistics stays pending until address, protocol and port are confirmed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="400" height="70" as="geometry"/></mxCell><mxCell id="093" value="AP-GER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.08394160583941605;entryDx=0;entryDy=0;" edge="1" parent="1" source="z0" target="ap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="094" value="AP-SOP" style="edgeStyle=orthogonalEdgeStyle;rou